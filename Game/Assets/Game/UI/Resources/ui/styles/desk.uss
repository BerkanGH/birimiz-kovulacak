/* Birimiz Kovulacak v4 — desk UI (office phases). Loaded by DeskUi from Resources/ui/styles/desk.
   Office stationery: paper rgb(244,239,227), light paper rgb(250,247,238), manila rgb(232,201,138), ink navy rgb(31,42,68),
   stamp red rgb(210,56,47), sticky rgb(255,224,102), office green rgb(47,107,79). No coloured side stripes anywhere:
   kinds are told by paper tint, icon and stamp. ".dk-skinned" = the v3 art 9-slice is applied, ".dk-unskinned" = USS look. */

.dk-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.dk-tile { background-color: rgba(0, 0, 0, 0); border-width: 0; margin: 0; padding: 0; border-radius: 0; -unity-text-align: middle-left; white-space: normal; }
.dk-key { margin-right: 8px; }
.dk-key-s { height: 26px; min-width: 26px; font-size: 14px; margin: 0 0 0 6px; padding: 0 6px; border-bottom-width: 3px; border-radius: 6px; }
.dk-good { color: rgb(47, 107, 79); }
.dk-bad { color: rgb(210, 56, 47); }
.dk-neutral { color: rgb(107, 111, 128); }
.dk-empty { font-size: 16px; color: rgb(107, 111, 128); -unity-font-style: italic; white-space: normal; }
.dk-primary { min-width: 200px; }
.dk-secondary { margin-right: 8px; }
.dk-section-band { font-size: 20px; color: rgb(210, 56, 47); letter-spacing: 2px; margin-bottom: 6px; }
.dk-heading { flex-direction: row; align-items: center; margin: 2px 0 8px 0; }
.dk-heading-text { font-size: 22px; color: rgb(31, 42, 68); letter-spacing: 1px; }
.dk-heading-hint { font-size: 15px; color: rgb(107, 111, 128); margin-left: 12px; white-space: normal; flex-shrink: 1; }
.dk-live-dot { width: 14px; height: 14px; border-radius: 7px; background-color: rgb(90, 200, 120); margin-right: 10px; border-width: 2px; border-color: rgba(255, 255, 255, 0.6); }

/* ---------------------------------------------------------------- stamps */
.dk-stamp { -unity-background-scale-mode: scale-to-fit; align-items: center; justify-content: center; }
.dk-stamp-art { width: 300px; height: 100px; }
.dk-stamp-fallback { border-width: 5px; border-color: rgba(210, 56, 47, 0.9); border-radius: 8px; padding: 0 16px; background-color: rgba(255, 255, 255, 0.12); }
.dk-stamp-text { font-size: 38px; color: rgba(210, 56, 47, 0.92); letter-spacing: 2px; -unity-text-align: middle-center; white-space: nowrap; }
.dk-reveal-stamp-green.dk-stamp-fallback { border-color: rgba(47, 107, 79, 0.9); }
.dk-reveal-stamp-green .dk-stamp-text { color: rgba(47, 107, 79, 0.95); }

/* ---------------------------------------------------------------- cards (round / trick art with a printed label) */
.dk-card { width: 256px; height: 358px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.dk-card-label { position: absolute; left: 10%; right: 10%; top: 76.5%; bottom: 7%; -unity-text-align: middle-center; font-size: 24px; color: rgb(31, 42, 68); white-space: normal; }
.dk-card-fallback { background-color: rgb(232, 201, 138); border-radius: 18px; border-width: 4px; border-color: rgb(31, 42, 68); border-bottom-width: 8px; align-items: center; justify-content: center; padding: 16px; }
.dk-card-fallback-icon { width: 120px; height: 120px; }
.dk-card-fallback-name { font-size: 24px; -unity-text-align: middle-center; margin-top: 10px; }
.dk-round-art-fallback { background-color: rgb(232, 201, 138); border-radius: 18px; border-width: 4px; border-color: rgb(31, 42, 68); align-items: center; justify-content: center; }

/* ---------------------------------------------------------------- HUD-lite */
.dk-deskblock { position: absolute; left: 28px; top: 26px; flex-direction: row; align-items: flex-start; }
.dk-cal { width: 178px; background-color: rgb(250, 247, 238); border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 7px; border-radius: 10px; align-items: center; padding-bottom: 8px; rotate: -2deg; }
.dk-cal-rings { position: absolute; top: -9px; left: 26px; right: 26px; flex-direction: row; justify-content: space-between; }
.dk-cal-ring { width: 12px; height: 22px; border-radius: 6px; background-color: rgb(31, 42, 68); border-width: 2px; border-color: rgb(120, 126, 145); }
.dk-cal-band { align-self: stretch; background-color: rgb(210, 56, 47); color: rgb(250, 247, 238); font-size: 20px; letter-spacing: 2px; -unity-text-align: middle-center; padding: 12px 0 3px 0; border-top-left-radius: 6px; border-top-right-radius: 6px; }
.dk-cal-day { font-size: 29px; color: rgb(31, 42, 68); margin-top: 2px; -unity-text-align: middle-center; white-space: nowrap; }
.dk-cal-sub { font-size: 14px; color: rgb(107, 111, 128); -unity-text-align: middle-center; }
.dk-clock { margin-left: 16px; margin-top: 12px; background-color: rgb(31, 42, 68); border-radius: 14px; padding: 4px 18px 8px 18px; border-width: 3px; border-color: rgb(12, 18, 32); border-bottom-width: 7px; align-items: center; min-width: 170px; }
.dk-clock-digits { font-size: 46px; color: rgb(196, 232, 170); -unity-text-align: middle-center; }
.dk-clock-sub { font-size: 14px; color: rgb(232, 201, 138); -unity-text-align: middle-center; max-width: 230px; white-space: normal; }
.dk-clock-urgent .dk-clock-digits { color: rgb(255, 130, 110); }

.dk-topwrap { position: absolute; top: 18px; left: 0; right: 0; align-items: center; }
.dk-midwrap { position: absolute; top: 57%; left: 0; right: 0; align-items: center; }
.dk-hover { align-items: center; background-color: rgba(250, 247, 238, 0.96); border-width: 2px; border-color: rgb(31, 42, 68); border-bottom-width: 4px; border-radius: 10px; padding: 4px 16px 6px 16px; }
.dk-hover-text { font-size: 20px; color: rgb(31, 42, 68); }
.dk-hover-sub { font-size: 14px; color: rgb(107, 111, 128); }

.dk-keys { position: absolute; right: 24px; bottom: 22px; flex-direction: row; }
.dk-keyhint { flex-direction: row; align-items: center; background-color: rgba(250, 247, 238, 0.94); border-radius: 10px; border-width: 2px; border-color: rgb(31, 42, 68); border-bottom-width: 4px; padding: 4px 12px 4px 6px; margin-left: 10px; }
.dk-keyhint .keycap { margin-right: 8px; height: 30px; font-size: 16px; }
.dk-keyhint-text { font-size: 17px; color: rgb(31, 42, 68); }

.dk-callstrip { flex-direction: row; align-items: center; background-color: rgb(250, 247, 238); border-radius: 16px; border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 7px; padding: 8px 14px 8px 14px; }
.dk-callstrip-live { background-color: rgb(226, 243, 230); }
.dk-callstrip-dead { background-color: rgb(255, 228, 218); }
.dk-callstrip-icon { width: 40px; height: 40px; margin-right: 10px; }
.dk-callstrip > .pbadge { margin-right: 10px; }
.dk-callstrip-col { margin-right: 16px; }
.dk-callstrip-name { font-size: 21px; color: rgb(31, 42, 68); margin-right: 12px; }
.dk-callstrip-col .dk-callstrip-name { margin-right: 0; }
.dk-callstrip-sub { font-size: 13px; color: rgb(107, 111, 128); }
.dk-callstrip-timer { font-size: 28px; margin-right: 14px; color: rgb(47, 107, 79); }
.dk-callstrip-dead .dk-callstrip-timer { color: rgb(210, 56, 47); }
.dk-callstrip-timer-soft { color: rgb(107, 111, 128); }
.dk-callstrip-btn { margin: 0 0 0 6px; }
.dk-rec-stamp { margin-right: 8px; }
.dk-rec-stamp.dk-stamp-art { width: 138px; height: 46px; }
.dk-rec-stamp .dk-stamp-text { font-size: 22px; }
.dk-tapstrip { flex-direction: row; align-items: center; margin-top: 8px; background-color: rgb(31, 42, 68); border-radius: 12px; padding: 4px 14px 4px 6px; }
.dk-tap-icon { width: 34px; height: 34px; margin-right: 8px; }
.dk-tap-text { color: rgb(244, 239, 227); font-size: 16px; }
.dk-tap-timer { color: rgb(255, 224, 102); font-size: 18px; margin-left: 10px; }

/* ---------------------------------------------------------------- notifications (paper slips) */
.dk-notes { position: absolute; right: 24px; top: 24px; width: 450px; align-items: flex-end; }
.dk-slip { flex-direction: row; align-items: center; min-width: 300px; max-width: 450px; padding: 14px 22px 14px 16px; margin-bottom: 10px; -unity-slice-left: 36; -unity-slice-top: 36; -unity-slice-right: 36; -unity-slice-bottom: 36; -unity-slice-scale: 0.5px; }
.dk-slip.dk-unskinned { background-color: rgb(250, 247, 238); border-width: 2px; border-bottom-width: 4px; border-color: rgb(31, 42, 68); border-radius: 10px; }
.dk-slip-sticky.dk-skinned, .dk-slip-manager.dk-skinned { -unity-slice-left: 32; -unity-slice-top: 32; -unity-slice-right: 40; -unity-slice-bottom: 40; -unity-slice-scale: 0.5px; padding: 14px 24px 18px 16px; }
.dk-slip-pin { position: absolute; top: -5px; left: 50%; width: 14px; height: 14px; margin-left: -7px; border-radius: 7px; background-color: rgb(210, 56, 47); border-width: 2px; border-color: rgb(120, 24, 20); }
.dk-slip-icon { width: 42px; height: 42px; margin-right: 12px; }
.dk-slip-badge { margin-right: 12px; }
.dk-slip-col { flex-shrink: 1; }
.dk-slip-title { font-size: 18px; color: rgb(31, 42, 68); white-space: normal; }
.dk-slip-sub { font-size: 14px; color: rgb(90, 96, 115); white-space: normal; }
.dk-slip-bad.dk-skinned { -unity-background-image-tint-color: rgb(255, 214, 200); }
.dk-slip-bad.dk-unskinned { background-color: rgb(255, 226, 216); }
.dk-slip-good.dk-skinned { -unity-background-image-tint-color: rgb(214, 240, 222); }
.dk-slip-good.dk-unskinned { background-color: rgb(225, 243, 230); }
.dk-slip-sticky.dk-unskinned, .dk-slip-manager.dk-unskinned { background-color: rgb(255, 224, 102); border-width: 0; }
.dk-slip-dark { background-image: none; background-color: rgb(31, 42, 68); border-radius: 10px; border-width: 2px; border-color: rgb(12, 18, 32); border-bottom-width: 4px; }
.dk-slip-dark .dk-slip-title { color: rgb(244, 239, 227); }
.dk-slip-dark .dk-slip-sub { color: rgb(200, 205, 220); }
.dk-slip-dark .dk-slip-pin { background-color: rgb(255, 224, 102); border-color: rgb(170, 140, 40); }

/* ---------------------------------------------------------------- incoming call */
.dk-incoming { width: 780px; background-color: rgb(250, 247, 238); border-radius: 18px; border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 8px; overflow: hidden; }
.dk-incoming-manager { background-color: rgb(255, 238, 186); }
.dk-incoming-row { flex-direction: row; align-items: center; padding: 14px 18px 12px 18px; }
.dk-incoming-icon { width: 56px; height: 56px; margin-right: 10px; }
.dk-incoming-badge { margin-right: 16px; }
.dk-incoming-col { flex-grow: 1; flex-shrink: 1; }
.dk-incoming-band { font-size: 17px; color: rgb(210, 56, 47); letter-spacing: 2px; }
.dk-incoming-name { font-size: 36px; color: rgb(31, 42, 68); margin-top: -6px; }
.dk-incoming-sub { font-size: 15px; color: rgb(107, 111, 128); }
.dk-incoming-actions { flex-direction: row; }
.dk-incoming-action { flex-direction: row; align-items: center; margin-left: 8px; }
.dk-incoming-btn { margin: 0; }
.dk-incoming-bar { height: 7px; background-color: rgba(31, 42, 68, 0.12); }
.dk-incoming-fill { height: 100%; background-color: rgb(210, 56, 47); }

/* ---------------------------------------------------------------- computer */
.dk-monitor { position: absolute; left: 44px; right: 44px; top: 20px; bottom: 20px; background-color: rgb(40, 46, 60); border-radius: 26px; padding: 16px; border-width: 3px; border-color: rgb(14, 18, 28); border-bottom-width: 10px; }
.dk-screen { flex-grow: 1; border-radius: 10px; overflow: hidden; background-color: rgb(242, 237, 224); -unity-background-scale-mode: scale-and-crop; }
.dk-watermark { position: absolute; width: 420px; height: 420px; left: 50%; top: 44%; margin-left: -210px; margin-top: -210px; opacity: 0.1; -unity-background-scale-mode: scale-to-fit; }
.dk-desktop { flex-grow: 1; flex-direction: row; padding: 18px 22px 10px 16px; }
.dk-desk-icons { width: 128px; margin-right: 14px; }
.dk-desk-icon { width: 122px; height: 120px; align-items: center; justify-content: center; margin-bottom: 8px; border-radius: 14px; border-width: 2px; border-color: rgba(0, 0, 0, 0); padding: 6px 4px; }
.dk-desk-icon:hover { background-color: rgba(255, 253, 247, 0.75); border-color: rgba(31, 42, 68, 0.25); }
.dk-desk-icon-on { background-color: rgb(255, 250, 235); border-color: rgb(31, 42, 68); border-bottom-width: 5px; }
.dk-desk-icon-img { width: 64px; height: 64px; }
.dk-desk-icon-label { font-size: 16px; color: rgb(31, 42, 68); -unity-text-align: middle-center; margin-top: 2px; -unity-font-style: bold; }
.dk-desk-icon-key { position: absolute; top: 4px; left: 8px; font-size: 11px; color: rgb(140, 140, 150); }
.dk-desk-icon-badge { position: absolute; top: 2px; right: 6px; background-color: rgb(210, 56, 47); color: rgb(255, 255, 255); border-radius: 13px; min-width: 26px; height: 26px; font-size: 14px; -unity-text-align: middle-center; padding: 0 6px; border-width: 2px; border-color: rgb(250, 247, 238); }

.dk-window { flex-grow: 1; flex-shrink: 1; -unity-slice-left: 40; -unity-slice-top: 104; -unity-slice-right: 40; -unity-slice-bottom: 40; -unity-slice-scale: 0.75px; }
.dk-window.dk-unskinned { background-color: rgb(244, 239, 227); border-width: 3px; border-color: rgb(31, 42, 68); border-radius: 14px; }
.dk-window.dk-unskinned .dk-window-title { background-color: rgb(232, 201, 138); margin: 0; border-bottom-width: 3px; border-color: rgb(31, 42, 68); border-top-left-radius: 11px; border-top-right-radius: 11px; }
.dk-window-title { flex-direction: row; align-items: center; height: 50px; margin: 9px 12px 0 12px; padding: 0 14px 0 8px; }
.dk-window-icon { width: 42px; height: 42px; margin-right: 10px; }
.dk-window-title-text { font-size: 26px; color: rgb(31, 42, 68); }
.dk-window-sub { font-size: 16px; color: rgb(96, 74, 34); }
.dk-window-body { flex-grow: 1; padding: 18px 28px 22px 28px; }
.dk-app { flex-grow: 1; }

.dk-taskbar { height: 64px; flex-direction: row; align-items: center; padding: 0 16px 0 16px; margin: 0 14px 10px 14px; -unity-slice-left: 26; -unity-slice-top: 28; -unity-slice-right: 26; -unity-slice-bottom: 30; -unity-slice-scale: 0.75px; }
.dk-taskbar.dk-unskinned { background-color: rgb(250, 247, 238); border-width: 3px; border-color: rgb(232, 201, 138); border-radius: 14px; }
.dk-tb-start { flex-direction: row; align-items: center; }
.dk-tb-logo { width: 38px; height: 38px; -unity-background-scale-mode: scale-to-fit; margin-right: 8px; }
.dk-tb-logo-fallback { background-color: rgb(47, 107, 79); border-radius: 8px; }
.dk-tb-brand { font-size: 24px; color: rgb(47, 107, 79); letter-spacing: 2px; }
.dk-tb-user { flex-direction: row; align-items: center; margin-left: 26px; padding-left: 18px; border-left-width: 2px; border-color: rgba(31, 42, 68, 0.15); }
.dk-tb-user-name { font-size: 16px; margin-left: 8px; color: rgb(31, 42, 68); }
.dk-tb-net { width: 36px; height: 36px; margin-right: 14px; }
.dk-tb-clock { flex-direction: row; align-items: center; margin-right: 18px; }
.dk-tb-clock-digits { font-size: 24px; color: rgb(31, 42, 68); }
.dk-tb-clock-sub { font-size: 14px; color: rgb(107, 111, 128); margin-right: 10px; }
.dk-tb-leave { flex-direction: row; align-items: center; }
.dk-tb-leave-btn { margin: 0; }

.dk-blocked { position: absolute; left: 0; top: 0; right: 0; bottom: 72px; align-items: center; justify-content: center; }
.dk-blocked-coffee { background-color: rgba(70, 45, 25, 0.18); }
.dk-blocked-offline { background-color: rgba(30, 36, 50, 0.72); }
.dk-blocked-art { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.dk-blocked-slip { width: 600px; padding: 30px 40px 34px 40px; align-items: center; rotate: -2deg; -unity-slice-left: 36; -unity-slice-top: 36; -unity-slice-right: 36; -unity-slice-bottom: 36; -unity-slice-scale: 0.6px; }
.dk-blocked-slip.dk-unskinned { background-color: rgb(250, 247, 238); border-width: 3px; border-color: rgb(31, 42, 68); border-radius: 12px; }
.dk-blocked-title { font-size: 36px; color: rgb(31, 42, 68); -unity-text-align: middle-center; }
.dk-blocked-sub { font-size: 19px; -unity-text-align: middle-center; white-space: normal; color: rgb(60, 66, 84); margin-top: 4px; }
.dk-blocked-timer { font-size: 54px; color: rgb(210, 56, 47); margin-top: 6px; }

/* ---------------------------------------------------------------- centre cards */
.dk-cards-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(20, 26, 42, 0.62); align-items: center; justify-content: center; }
.dk-cards-dim-soft { background-color: rgba(20, 26, 42, 0.5); }
.dk-cards-slot { align-items: center; justify-content: center; }
.dk-card-foot { flex-direction: row; align-items: center; }
.dk-card-foot-hint { font-size: 15px; color: rgb(107, 111, 128); white-space: normal; flex-shrink: 1; }

.dk-morning { width: 1200px; background-color: rgb(244, 239, 227); border-radius: 20px; border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 9px; overflow: hidden; }
.dk-morning-head { flex-direction: row; align-items: center; background-color: rgb(31, 42, 68); padding: 10px 24px; }
.dk-morning-line { font-size: 24px; color: rgb(244, 239, 227); letter-spacing: 2px; }
.dk-morning-day { font-size: 24px; color: rgb(255, 224, 102); letter-spacing: 2px; }
.dk-morning-body { flex-direction: row; padding: 24px 30px 6px 30px; }
.dk-morning-who { width: 210px; align-items: center; }
.dk-morning-name { font-size: 28px; margin-top: 8px; color: rgb(31, 42, 68); -unity-text-align: middle-center; }
.dk-morning-title { font-size: 17px; color: rgb(210, 56, 47); }
.dk-morning-talk { flex-grow: 1; flex-shrink: 1; margin-left: 26px; }
.dk-bubble { align-self: flex-start; background-color: rgb(255, 255, 252); border-width: 2px; border-color: rgb(31, 42, 68); border-bottom-width: 4px; border-radius: 18px; border-top-left-radius: 4px; padding: 10px 20px 12px 18px; margin-bottom: 10px; max-width: 860px; }
.dk-bubble-text { font-size: 22px; white-space: normal; color: rgb(31, 42, 68); }
.dk-morning-today { padding: 10px 30px 0 30px; }
.dk-morning-rounds { flex-direction: row; align-items: stretch; }
.dk-mini-round { flex-direction: row; width: 380px; margin-right: 16px; background-color: rgb(255, 253, 247); border-radius: 14px; border-width: 2px; border-color: rgba(31, 42, 68, 0.2); border-bottom-width: 4px; padding: 10px 14px 10px 10px; align-items: center; }
.dk-mini-card { width: 104px; height: 146px; }
.dk-mini-card .dk-card-label { font-size: 10px; }
.dk-mini-round-col { flex-shrink: 1; margin-left: 14px; }
.dk-mini-round-n { font-size: 13px; color: rgb(107, 111, 128); }
.dk-mini-round-name { font-size: 26px; color: rgb(31, 42, 68); }
.dk-mini-round-rule { font-size: 15px; white-space: normal; color: rgb(60, 66, 84); }
.dk-fav { flex-direction: row; align-items: center; flex-grow: 1; background-color: rgb(255, 224, 102); border-radius: 4px; padding: 12px 16px; rotate: 1deg; }
.dk-fav-icon { width: 46px; height: 46px; margin-right: 6px; }
.dk-fav-col { margin-left: 12px; flex-shrink: 1; }
.dk-fav-band { font-size: 16px; color: rgb(210, 56, 47); letter-spacing: 1px; }
.dk-fav-name { font-size: 28px; color: rgb(31, 42, 68); }
.dk-fav-rule { font-size: 14px; white-space: normal; color: rgb(60, 66, 84); }
.dk-morning .dk-card-foot { padding: 16px 30px 22px 30px; }

.dk-intro { flex-direction: row; width: 1260px; background-color: rgb(244, 239, 227); border-radius: 24px; border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 9px; padding: 34px 38px; }
.dk-intro-art { width: 340px; height: 476px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.dk-intro-art .dk-card-label { font-size: 32px; }
.dk-intro-art-back { background-color: rgb(47, 107, 79); border-radius: 18px; border-width: 5px; border-color: rgb(232, 201, 138); }
.dk-intro-art-icon { width: 180px; height: 180px; }
.dk-intro-art-name { font-size: 30px; margin-top: 12px; }
.dk-intro-col { flex-grow: 1; flex-shrink: 1; margin-left: 42px; }
.dk-intro-bandrow { flex-direction: row; }
.dk-intro-title { font-size: 66px; color: rgb(31, 42, 68); margin-top: -8px; }
.dk-intro-rule { font-size: 30px; white-space: normal; margin-top: 4px; color: rgb(31, 42, 68); }
.dk-intro-example { margin-top: 20px; background-color: rgb(255, 224, 102); padding: 14px 20px 16px 20px; rotate: -1deg; border-radius: 3px; align-self: flex-start; max-width: 760px; }
.dk-intro-example-text { font-size: 25px; white-space: normal; color: rgb(31, 42, 68); }
.dk-intro-more { margin-top: 20px; }
.dk-intro-more-band { font-size: 18px; color: rgb(107, 111, 128); letter-spacing: 2px; margin-bottom: 4px; }
.dk-intro-more-line { flex-direction: row; align-items: flex-start; margin-bottom: 6px; }
.dk-bullet { width: 10px; height: 10px; border-radius: 5px; background-color: rgb(210, 56, 47); margin: 9px 12px 0 0; flex-shrink: 0; }
.dk-intro-more-text { font-size: 19px; white-space: normal; flex-shrink: 1; color: rgb(31, 42, 68); }
.dk-intro .dk-card-foot { margin-top: 22px; }
.dk-intro-timer { flex-direction: row; align-items: center; }
.dk-intro-bar { width: 220px; height: 10px; background-color: rgba(31, 42, 68, 0.15); border-radius: 5px; overflow: hidden; }
.dk-intro-fill { height: 100%; background-color: rgb(31, 42, 68); }
.dk-intro-secs { font-size: 20px; margin-left: 10px; color: rgb(31, 42, 68); }
.dk-intro-stamp { position: absolute; right: -10px; top: -30px; }

.dk-unlock { flex-direction: row; width: 1100px; background-color: rgb(244, 239, 227); border-radius: 24px; border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 9px; padding: 32px 36px; }
.dk-unlock-art { width: 280px; height: 392px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.dk-unlock-art .dk-card-label { font-size: 26px; }
.dk-unlock-art-icon { align-items: center; justify-content: center; background-color: rgb(255, 236, 228); border-radius: 18px; border-width: 3px; border-color: rgba(31, 42, 68, 0.2); }
.dk-unlock-icon { width: 220px; height: 220px; }
.dk-unlock-col { flex-grow: 1; flex-shrink: 1; margin-left: 36px; }
.dk-unlock-title { font-size: 50px; color: rgb(31, 42, 68); }
.dk-unlock-name { font-size: 26px; color: rgb(210, 56, 47); }
.dk-unlock-text { font-size: 23px; white-space: normal; margin-top: 8px; color: rgb(31, 42, 68); }
.dk-unlock-where { font-size: 17px; color: rgb(107, 111, 128); margin-top: 12px; white-space: normal; }
.dk-unlock-stamp { position: absolute; right: 50px; top: -34px; }

/* ---------------------------------------------------------------- desk phone */
.dk-phone-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(20, 26, 42, 0.38); align-items: center; justify-content: center; }
.dk-phone-wrap { flex-direction: row; align-items: flex-start; }
.dk-phone { width: 720px; background-color: rgb(238, 228, 204); border-radius: 38px; border-width: 4px; border-color: rgb(31, 42, 68); border-bottom-width: 14px; padding: 26px 30px 22px 30px; }
.dk-phone-ivr { background-color: rgb(246, 222, 210); }
.dk-phone-dead { background-color: rgb(214, 208, 196); }
.dk-lcd { height: 150px; padding: 24px 34px 22px 34px; -unity-slice-left: 44; -unity-slice-top: 44; -unity-slice-right: 44; -unity-slice-bottom: 44; -unity-slice-scale: 0.6px; }
.dk-lcd.dk-unskinned { background-color: rgb(150, 172, 128); border-radius: 14px; border-width: 6px; border-color: rgb(60, 70, 60); }
.dk-lcd-row { flex-direction: row; align-items: center; flex-grow: 1; }
.dk-lcd-icon { width: 76px; height: 58px; -unity-background-scale-mode: scale-to-fit; margin-right: 12px; }
.dk-lcd-col { flex-grow: 1; flex-shrink: 1; }
.dk-lcd-1 { font-size: 32px; color: rgb(28, 40, 22); white-space: normal; }
.dk-lcd-2 { font-size: 17px; color: rgb(40, 58, 32); white-space: normal; }
.dk-lcd-time { font-size: 30px; color: rgb(28, 40, 22); margin-left: 10px; }
.dk-lcd-rec { position: absolute; right: 26px; top: -18px; width: 100px; height: 56px; -unity-background-scale-mode: scale-to-fit; }
.dk-lcd-rec-fallback { background-color: rgb(210, 56, 47); border-radius: 8px; width: 70px; height: 32px; align-items: center; justify-content: center; }
.dk-lcd-rec-text { color: rgb(255, 255, 255); font-size: 18px; }
.dk-dial-label { flex-direction: row; align-items: center; margin: 16px 4px 6px 4px; }
.dk-dial-label-text { font-size: 18px; color: rgb(120, 96, 50); letter-spacing: 2px; }
.dk-dial-label-hint { font-size: 13px; color: rgb(120, 110, 90); }
.dk-dial { background-color: rgb(255, 253, 247); border-radius: 10px; border-width: 2px; border-color: rgba(31, 42, 68, 0.3); padding: 4px 12px; }
.dk-dial-row { flex-direction: row; align-items: center; padding: 6px 4px; border-bottom-width: 1px; border-color: rgba(59, 134, 216, 0.25); }
.dk-dial-row:hover { background-color: rgba(255, 224, 102, 0.3); }
.dk-dial-row:disabled { opacity: 0.45; }
.dk-dial-row-ivr:hover { background-color: rgba(210, 56, 47, 0.12); }
.dk-dial-row-on { background-color: rgba(210, 56, 47, 0.18); }
.dk-dial-key { width: 54px; height: 40px; align-items: center; justify-content: center; margin-right: 12px; -unity-slice-left: 28; -unity-slice-top: 28; -unity-slice-right: 28; -unity-slice-bottom: 28; -unity-slice-scale: 0.5px; }
.dk-dial-key.dk-unskinned { background-color: rgb(250, 247, 238); border-radius: 8px; border-width: 2px; border-bottom-width: 4px; border-color: rgb(31, 42, 68); }
.dk-dial-key-red { background-color: rgb(210, 56, 47); border-radius: 8px; border-width: 2px; border-color: rgb(31, 42, 68); border-bottom-width: 4px; }
.dk-dial-key-red .dk-dial-key-text { color: rgb(250, 247, 238); }
.dk-dial-key-text { font-size: 20px; color: rgb(31, 42, 68); }
.dk-dial-name { font-size: 20px; margin-left: 10px; color: rgb(31, 42, 68); }
.dk-dial-call { width: 30px; height: 30px; margin-left: 10px; }
.dk-dial-tip { font-size: 15px; color: rgb(210, 56, 47); margin-left: 10px; }
.dk-dial-manager { border-bottom-width: 0; }
.dk-dial-mgr-icon { width: 44px; height: 44px; }
.dk-dial-mgr-col { margin-left: 2px; flex-grow: 1; }
.dk-dial-mgr-sub { font-size: 13px; color: rgb(107, 111, 128); margin-left: 10px; }
.dk-phone-actions { flex-direction: row; align-items: center; margin-top: 14px; min-height: 56px; }
.dk-phone-rule { font-size: 15px; color: rgb(90, 76, 50); white-space: normal; flex-shrink: 1; max-width: 420px; }
.dk-phone-recorded { color: rgb(210, 56, 47); margin-right: 10px; max-width: 220px; }
.dk-ptt { flex-direction: row; align-items: center; }
.dk-ptt-text { font-size: 16px; color: rgb(31, 42, 68); }
.dk-notepad { width: 380px; height: 560px; margin-left: 26px; margin-top: 40px; background-color: rgb(255, 247, 200); border-radius: 4px; padding: 14px 22px 18px 22px; rotate: 2deg; border-width: 1px; border-color: rgba(31, 42, 68, 0.2); border-top-width: 24px; border-top-color: rgb(31, 42, 68); }
.dk-notepad-title { font-size: 30px; color: rgb(31, 42, 68); }
.dk-notepad-scroll { flex-grow: 1; }
.dk-notepad-empty { font-size: 20px; color: rgb(107, 111, 128); }
.dk-log-row { flex-direction: row; align-items: center; padding: 5px 0; border-bottom-width: 1px; border-color: rgba(59, 134, 216, 0.35); }
.dk-log-col { margin-left: 8px; flex-shrink: 1; }
.dk-log-who { font-size: 20px; color: rgb(31, 42, 68); }
.dk-log-what { font-size: 16px; color: rgb(80, 86, 104); margin-top: -4px; }
.dk-log-row-miss .dk-log-what { color: rgb(210, 56, 47); }
.dk-log-time { font-size: 15px; color: rgb(107, 111, 128); }
.dk-phone-close { position: absolute; right: 0; bottom: -62px; flex-direction: row; align-items: center; }

/* ---------------------------------------------------------------- onboarding */
.dk-ob-note { position: absolute; left: 30px; top: 214px; width: 340px; padding: 22px 26px 34px 24px; rotate: -2deg; -unity-slice-left: 32; -unity-slice-top: 32; -unity-slice-right: 40; -unity-slice-bottom: 40; -unity-slice-scale: 0.6px; }
.dk-ob-note.dk-unskinned { background-color: rgb(255, 224, 102); border-radius: 3px; }
.dk-ob-compact { top: auto; left: 20px; bottom: 120px; width: 270px; rotate: -4deg; padding: 14px 18px 24px 16px; }
.dk-ob-title { font-size: 27px; margin-bottom: 6px; color: rgb(31, 42, 68); }
.dk-ob-compact .dk-ob-title { font-size: 18px; margin-bottom: 2px; color: rgb(110, 84, 40); }
.dk-ob-row { flex-direction: row; align-items: center; margin-bottom: 3px; }
.dk-ob-box { width: 32px; height: 32px; margin-right: 8px; }
.dk-ob-text { font-size: 21px; white-space: normal; flex-shrink: 1; color: rgb(31, 42, 68); }
.dk-ob-done .dk-ob-text { color: rgba(31, 42, 68, 0.4); }
.dk-ob-now .dk-ob-text { color: rgb(210, 56, 47); }
.dk-ob-arrow { position: absolute; left: 0; top: 0; width: 200px; height: 100px; -unity-background-scale-mode: scale-to-fit; }

/* ---------------------------------------------------------------- fixes after the first screenshot pass */
.dk-locked-stamp { margin-right: 16px; }
.dk-locked-stamp.dk-stamp-fallback { border-color: rgba(47, 107, 79, 0.9); padding: 0 12px; }
.dk-locked-stamp .dk-stamp-text { font-size: 26px; color: rgba(47, 107, 79, 0.95); }
.dk-system-badge { background-color: rgb(31, 42, 68); border-color: rgb(31, 42, 68); }
.dk-system-badge-icon { width: 70%; height: 70%; }
.dk-system-badge .icon-fallback { background-color: rgba(0, 0, 0, 0); }
.dk-reveal-hidden-col { flex-direction: column; align-items: center; }
.dk-reveal-hidden-col .dk-reveal-small { margin-bottom: 6px; }
.dk-code > .dk-reveal-stamp, .dk-code > .dk-reveal-stamp-green { top: -40px; right: -30px; }
.dk-incoming-phone { width: 104px; height: 78px; margin-right: 8px; flex-shrink: 0; }
.dk-incoming-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; }
.dk-incoming-handset { transform-origin: 57% 23%; }
.dk-incoming-waves { position: absolute; left: -14px; top: -10px; right: -14px; bottom: -4px; -unity-background-scale-mode: scale-to-fit; opacity: 0; }

/* ================================================================ v4 desk additions ================================================================ */

/* desktop icons: two columns of app tiles */
.dk-desk-icons { width: 262px; flex-direction: row; flex-wrap: wrap; align-content: flex-start; margin-right: 14px; }
.dk-desk-icon { width: 122px; height: 112px; margin-right: 6px; margin-bottom: 6px; }
.dk-desk-icon-img { width: 58px; height: 58px; }
.dk-desk-icon-label { font-size: 15px; }
.dk-window-body { padding: 12px 18px 16px 18px; }

/* taskbar status strip */
.dk-taskbar { height: 72px; }
.dk-status-compact { flex-direction: row; align-items: center; margin-right: 16px; }
.dk-status-compact .dk-status-head { flex-direction: row; align-items: center; margin-right: 10px; }
.dk-status-compact .dk-status-title { font-size: 15px; margin-right: 8px; }
.dk-status-compact .dk-status-pct { font-size: 22px; }
.dk-status-compact .dk-gauge { width: 150px; height: 14px; margin-right: 10px; }
.dk-status-compact .dk-status-line { flex-direction: row; align-items: center; margin-right: 10px; }
.dk-status-compact .dk-status-target { font-size: 14px; margin-right: 8px; }
.dk-status-compact .dk-status-reason { font-size: 13px; max-width: 260px; }
.dk-status-compact .dk-status-chips { flex-direction: row; }

/* HUD left column and status panel */
.dk-hud-left { position: absolute; left: 28px; top: 26px; width: 380px; }
.dk-hud-left .dk-deskblock { position: relative; left: 0; top: 0; }
.dk-status { margin-top: 14px; background-color: rgba(250, 247, 238, 0.95); border-radius: 14px; border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 6px; padding: 8px 14px 10px 14px; }
.dk-status-compact.dk-status { margin-top: 0; background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0; }
.dk-status-head { flex-direction: row; align-items: center; }
.dk-status-title { font-size: 18px; color: rgb(31, 42, 68); letter-spacing: 1px; }
.dk-status-pct { font-size: 30px; color: rgb(31, 42, 68); }
.dk-status-pct-low { color: rgb(210, 56, 47); }
.dk-status-pct-ok { color: rgb(47, 107, 79); }
.dk-gauge { height: 18px; background-color: rgba(31, 42, 68, 0.15); border-radius: 9px; border-width: 2px; border-color: rgb(31, 42, 68); margin-top: 2px; }
.dk-gauge-measuring { background-color: rgba(232, 201, 138, 0.5); }
.dk-gauge-fill { height: 100%; background-color: rgb(47, 107, 79); border-radius: 7px; }
.dk-gauge-fill-low { background-color: rgb(210, 120, 47); }
.dk-gauge-target { position: absolute; top: -6px; width: 4px; height: 26px; margin-left: -2px; background-color: rgb(210, 56, 47); border-radius: 2px; }
.dk-status-line { margin-top: 4px; }
.dk-status-target { font-size: 15px; color: rgb(210, 56, 47); }
.dk-status-reason { font-size: 14px; color: rgb(60, 66, 84); white-space: normal; }
.dk-status-chips { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.dk-statchip { flex-direction: row; align-items: center; background-color: rgb(255, 253, 247); border-radius: 12px; border-width: 2px; border-color: rgba(31, 42, 68, 0.35); padding: 1px 10px 1px 4px; margin: 0 6px 4px 0; }
.dk-statchip-hot { background-color: rgb(255, 214, 200); border-color: rgb(210, 56, 47); }
.dk-statchip-icon { width: 22px; height: 22px; margin-right: 4px; }
.dk-statchip-text { font-size: 15px; color: rgb(31, 42, 68); }
.dk-obj { flex-direction: row; align-items: flex-start; margin-top: 6px; background-color: rgb(255, 224, 102); border-radius: 4px; padding: 8px 10px; rotate: -1deg; }
.dk-obj-icon { width: 32px; height: 32px; margin-right: 8px; }
.dk-obj-col { flex-shrink: 1; flex-grow: 1; }
.dk-obj-name { font-size: 16px; color: rgb(31, 42, 68); }
.dk-obj-text { font-size: 14px; white-space: normal; color: rgb(60, 66, 84); }
.dk-obj-bar { height: 8px; margin-top: 4px; background-color: rgba(31, 42, 68, 0.2); border-radius: 4px; }
.dk-obj-bar .bar-fill { background-color: rgb(31, 42, 68); }
.dk-tagrow { flex-direction: row; align-items: center; margin-top: 6px; }
.dk-tagrow-icon { width: 24px; height: 24px; margin-right: 6px; }
.dk-tagrow-text { font-size: 15px; color: rgb(31, 42, 68); white-space: normal; flex-shrink: 1; }
.dk-remstrip { flex-direction: row; align-items: center; margin-top: 8px; background-color: rgb(255, 238, 186); border-radius: 16px; border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 7px; padding: 8px 14px; }

/* highlight (tutorial) */
.dk-hl { border-width: 4px; border-color: rgb(210, 56, 47); border-radius: 12px; background-color: rgba(255, 224, 102, 0.22); }

/* ---------------------------------------------------------------- Task app */
.dk-app-task { flex-direction: column; }
.dk-task-head { flex-direction: row; align-items: center; padding: 6px 10px 8px 10px; border-bottom-width: 2px; border-color: rgba(31, 42, 68, 0.15); border-radius: 10px; border-width: 0; }
.dk-task-icon { width: 64px; height: 64px; border-radius: 14px; align-items: center; justify-content: center; margin-right: 14px; border-width: 3px; border-color: rgb(31, 42, 68); }
.dk-task-icon-img { width: 44px; height: 44px; }
.dk-task-head-col { flex-grow: 1; flex-shrink: 1; }
.dk-task-namerow { flex-direction: row; align-items: center; flex-wrap: wrap; }
.dk-task-name { font-size: 36px; color: rgb(31, 42, 68); margin-right: 12px; }
.dk-task-rule { font-size: 19px; white-space: normal; color: rgb(60, 66, 84); }
.dk-task-clock { flex-direction: row; align-items: center; background-color: rgb(31, 42, 68); border-radius: 12px; padding: 4px 16px 6px 12px; border-bottom-width: 5px; border-color: rgb(12, 18, 32); margin-left: 12px; }
.dk-task-clock-icon { width: 26px; height: 26px; margin-right: 8px; }
.dk-task-clock-text { font-size: 34px; color: rgb(196, 232, 170); }
.dk-task-clock-urgent .dk-task-clock-text { color: rgb(255, 130, 110); }
.dk-help { width: 46px; height: 46px; min-width: 46px; margin: 0 0 0 12px; padding: 0; font-size: 26px; border-radius: 23px; }
.dk-task-body { flex-direction: row; flex-grow: 1; margin-top: 8px; }
.dk-task-left { width: 40%; min-width: 380px; margin-right: 16px; }
.dk-task-right { flex-grow: 1; flex-shrink: 1; }
.dk-groupbox, .dk-infobox, .dk-pubbox, .dk-ctrlbox, .dk-submitbox { padding: 6px 8px 8px 8px; margin-bottom: 10px; border-width: 0; border-radius: 12px; }
.dk-gm { flex-direction: row; align-items: center; background-color: rgb(255, 253, 247); border-radius: 12px; border-width: 2px; border-color: rgba(31, 42, 68, 0.2); border-bottom-width: 4px; padding: 6px 10px; margin-bottom: 6px; }
.dk-gm-col { margin-left: 10px; flex-shrink: 1; }
.dk-gm-name { font-size: 20px; color: rgb(31, 42, 68); }
.dk-gm-cap { font-size: 13px; color: rgb(107, 111, 128); }
.dk-gm-btn { margin: 0 0 0 6px; }
.dk-paper { background-color: rgb(255, 253, 247); border-radius: 6px; border-width: 2px; border-color: rgba(31, 42, 68, 0.2); padding: 10px 14px; }
.dk-paper-pub { background-color: rgb(236, 244, 232); }
.dk-fact { flex-direction: row; align-items: flex-start; margin-bottom: 4px; }
.dk-fact-text { font-size: 19px; white-space: normal; flex-shrink: 1; flex-grow: 1; color: rgb(31, 42, 68); }
.dk-bullet { width: 10px; height: 10px; border-radius: 5px; background-color: rgb(210, 56, 47); margin: 9px 12px 0 0; flex-shrink: 0; }
.dk-ctl { background-color: rgb(255, 253, 247); border-radius: 12px; border-width: 2px; border-color: rgba(31, 42, 68, 0.25); border-bottom-width: 4px; padding: 10px 14px 12px 14px; margin-bottom: 10px; }
.dk-ctl-off { opacity: 0.55; }
.dk-ctl-locked { background-color: rgb(226, 243, 230); }
.dk-ctl-head { flex-direction: row; align-items: center; margin-bottom: 6px; }
.dk-ctl-label { font-size: 21px; color: rgb(31, 42, 68); }
.dk-ctl-hint { font-size: 14px; color: rgb(107, 111, 128); white-space: normal; margin-top: 2px; }
.dk-ctl-hint-bad { color: rgb(210, 56, 47); }
.dk-ctl-note { font-size: 15px; color: rgb(210, 56, 47); white-space: normal; margin-top: 4px; }
.dk-numdisp { flex-direction: row; justify-content: center; margin: 4px 0 6px 0; }
.dk-cell { min-width: 52px; height: 64px; margin: 0 4px; font-size: 38px; -unity-text-align: middle-center; background-color: rgb(244, 239, 227); border-radius: 8px; border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 6px; color: rgb(31, 42, 68); }
.dk-cell-on { border-color: rgb(210, 56, 47); background-color: rgb(255, 250, 235); }
.dk-keypad { flex-direction: row; flex-wrap: wrap; width: 288px; align-self: center; margin-top: 6px; }
.dk-keypad-key { width: 88px; height: 52px; margin: 3px; padding: 0; font-size: 26px; }
.dk-keypad-fn { font-size: 17px; }
.dk-opts { flex-direction: column; }
.dk-opts-grid { flex-direction: row; flex-wrap: wrap; }
.dk-opts-grid .dk-opt { width: 48%; margin-right: 2%; }
.dk-opt { flex-direction: row; align-items: center; background-color: rgb(250, 247, 238); border-radius: 10px; border-width: 2px; border-color: rgba(31, 42, 68, 0.3); border-bottom-width: 4px; padding: 8px 12px; margin-bottom: 6px; }
.dk-opt:hover { background-color: rgb(255, 244, 205); }
.dk-opt:disabled { opacity: 0.5; }
.dk-opt-on { background-color: rgb(214, 240, 222); border-color: rgb(47, 107, 79); border-width: 3px; }
.dk-opt-sab { background-color: rgb(255, 236, 228); }
.dk-opt-sab.dk-opt-on { background-color: rgb(255, 214, 200); border-color: rgb(210, 56, 47); }
.dk-opt-mark { width: 20px; height: 20px; border-radius: 10px; border-width: 3px; border-color: rgb(31, 42, 68); margin-right: 10px; flex-shrink: 0; }
.dk-opt-on .dk-opt-mark { background-color: rgb(47, 107, 79); }
.dk-opt-sab.dk-opt-on .dk-opt-mark { background-color: rgb(210, 56, 47); }
.dk-opt-text { font-size: 19px; color: rgb(31, 42, 68); white-space: normal; flex-shrink: 1; flex-grow: 1; }
.dk-item { flex-direction: row; align-items: center; flex-wrap: wrap; background-color: rgb(250, 247, 238); border-radius: 10px; border-width: 2px; border-color: rgba(31, 42, 68, 0.2); padding: 6px 10px; margin-bottom: 6px; }
.dk-item-icon { width: 32px; height: 32px; margin-right: 8px; }
.dk-item-name { font-size: 19px; color: rgb(31, 42, 68); }
.dk-submitbox { background-color: rgba(250, 247, 238, 0.7); }
.dk-submit-done { background-color: rgba(226, 243, 230, 0.8); }
.dk-task-status { font-size: 16px; color: rgb(60, 66, 84); white-space: normal; margin-bottom: 6px; }
.dk-task-status-bad { color: rgb(210, 56, 47); }
.dk-submit-row { flex-direction: row; align-items: center; justify-content: flex-end; }
.dk-confirm { background-color: rgb(255, 236, 228); border-radius: 12px; border-width: 3px; border-color: rgb(210, 56, 47); padding: 10px 14px; margin-bottom: 8px; }
.dk-confirm-title { font-size: 26px; color: rgb(210, 56, 47); }
.dk-confirm-opt { font-size: 19px; color: rgb(31, 42, 68); white-space: normal; }
.dk-confirm-rule { font-size: 16px; color: rgb(60, 66, 84); white-space: normal; margin-top: 4px; }
.dk-confirm-row { flex-direction: row; justify-content: flex-end; margin-top: 8px; }
.dk-task-empty { flex-grow: 1; align-items: center; justify-content: center; }
.dk-task-empty-icon { width: 90px; height: 90px; }
.dk-task-empty-title { font-size: 36px; color: rgb(31, 42, 68); margin-top: 8px; }
.dk-task-empty-sub { font-size: 18px; color: rgb(107, 111, 128); white-space: normal; max-width: 640px; -unity-text-align: middle-center; }
.dk-task-empty-row { flex-direction: row; margin-top: 18px; }
.dk-task-empty-card { width: 300px; margin: 0 14px; align-items: center; }
.dk-task-empty-name { font-size: 19px; margin-top: 8px; color: rgb(31, 42, 68); -unity-text-align: middle-center; white-space: normal; }
.dk-task-empty-rule { font-size: 14px; color: rgb(60, 66, 84); -unity-text-align: middle-center; white-space: normal; }

/* task card (art with a printed label, else coloured fallback) */
.dk-taskcard { width: 256px; height: 358px; flex-shrink: 0; align-items: center; justify-content: center; }
.dk-taskcard-art { -unity-background-scale-mode: scale-to-fit; }
.dk-taskcard-fallback { border-radius: 18px; border-width: 4px; border-color: rgb(31, 42, 68); border-bottom-width: 8px; padding: 16px; }
.dk-taskcard-icon { width: 110px; height: 110px; }
.dk-taskcard-name { font-size: 24px; color: rgb(255, 255, 255); -unity-text-align: middle-center; margin-top: 12px; white-space: normal; }
.dk-taskcard-s { width: 180px; height: 252px; }
.dk-taskcard-s .dk-taskcard-icon { width: 70px; height: 70px; }
.dk-taskcard-s .dk-taskcard-name { font-size: 17px; }
.dk-intro-card { width: 340px; height: 476px; }
.dk-intro-card .dk-taskcard-icon { width: 160px; height: 160px; }
.dk-intro-card .dk-taskcard-name { font-size: 34px; }
.dk-mini-card.dk-taskcard { width: 104px; height: 146px; }
.dk-mini-card .dk-taskcard-icon { width: 50px; height: 50px; }
.dk-mini-card .dk-taskcard-name { font-size: 12px; margin-top: 4px; }
.dk-intro-chips { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }

/* tutorial dock */
.dk-tut { width: 380px; flex-shrink: 0; margin-left: 4px; background-color: rgb(244, 239, 227); border-radius: 16px; border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 7px; padding: 10px 14px 12px 14px; }
.dk-tut-head { flex-direction: row; align-items: center; }
.dk-tut-band { font-size: 18px; color: rgb(210, 56, 47); letter-spacing: 2px; }
.dk-tut-step { font-size: 18px; color: rgb(107, 111, 128); margin-right: 8px; }
.dk-tut-x { margin: 0; }
.dk-tut-name { font-size: 26px; color: rgb(31, 42, 68); margin-top: 2px; white-space: normal; }
.dk-tut-art { height: 150px; margin-top: 6px; border-radius: 10px; -unity-background-scale-mode: scale-to-fit; align-items: center; justify-content: center; }
.dk-tut-art-fallback { border-width: 3px; border-color: rgb(31, 42, 68); }
.dk-tut-art-icon { width: 96px; height: 96px; }
.dk-tut-dots { flex-direction: row; justify-content: center; margin: 8px 0 4px 0; }
.dk-tut-dot { width: 14px; height: 14px; border-radius: 7px; margin: 0 4px; background-color: rgba(31, 42, 68, 0.2); }
.dk-tut-dot-seen { background-color: rgba(47, 107, 79, 0.55); }
.dk-tut-dot-on { background-color: rgb(210, 56, 47); width: 20px; }
.dk-tut-title { font-size: 28px; color: rgb(31, 42, 68); white-space: normal; }
.dk-tut-body { font-size: 18px; color: rgb(31, 42, 68); white-space: normal; margin-top: 2px; }
.dk-tut-example { margin-top: 10px; background-color: rgb(255, 224, 102); border-radius: 3px; padding: 8px 12px 10px 12px; rotate: -1deg; }
.dk-tut-example-band { font-size: 14px; color: rgb(110, 84, 40); letter-spacing: 2px; }
.dk-tut-example-text { font-size: 20px; white-space: normal; color: rgb(31, 42, 68); }
.dk-tut-hlrow { flex-direction: row; align-items: center; margin-top: 10px; }
.dk-tut-hl-icon { width: 28px; height: 28px; margin-right: 6px; }
.dk-tut-hl { font-size: 16px; color: rgb(210, 56, 47); white-space: normal; flex-shrink: 1; }
.dk-tut-foot { flex-direction: row; align-items: center; margin-top: 10px; }
.dk-tut-next { min-width: 140px; margin: 0; }

/* ---------------------------------------------------------------- shared composer / text inputs */
.dk-textbox { margin-top: 4px; }
.dk-input { margin: 0; }
.dk-input > TextInput, .dk-input .unity-base-text-field__input { background-color: rgb(255, 255, 252); color: rgb(31, 42, 68); font-size: 19px; border-width: 2px; border-color: rgb(31, 42, 68); border-radius: 8px; padding: 6px 10px; white-space: normal; -unity-text-align: upper-left; }
.dk-input-multi .unity-base-text-field__input { min-height: 78px; }
.dk-count { font-size: 14px; color: rgb(107, 111, 128); -unity-text-align: middle-right; margin-top: 2px; }
.dk-count-warn { color: rgb(210, 120, 47); }
.dk-count-full { color: rgb(210, 56, 47); }
.dk-composer { padding: 8px 4px 0 4px; border-top-width: 2px; border-color: rgba(31, 42, 68, 0.15); }
.dk-composer-foot { flex-direction: row; align-items: center; margin-top: 6px; }
.dk-composer-status { font-size: 15px; color: rgb(60, 66, 84); white-space: normal; flex-shrink: 1; margin-top: 2px; }
.dk-composer-status-bad { color: rgb(210, 56, 47); }
.dk-composer-send { min-width: 150px; margin: 0 0 0 10px; }

.dk-badge { background-color: rgb(210, 56, 47); color: rgb(255, 255, 255); border-radius: 12px; min-width: 24px; height: 24px; font-size: 14px; -unity-text-align: middle-center; padding: 0 6px; }

/* chips (colleague / template pickers) */
.dk-chips { flex-direction: row; flex-wrap: wrap; }
.dk-chip { flex-direction: row; align-items: center; background-color: rgb(250, 247, 238); border-radius: 18px; border-width: 2px; border-color: rgba(31, 42, 68, 0.35); border-bottom-width: 3px; padding: 3px 12px 3px 4px; margin: 0 6px 6px 0; }
.dk-chip:hover { background-color: rgb(255, 244, 205); }
.dk-chip:disabled { opacity: 0.4; }
.dk-chip-on { background-color: rgb(214, 240, 222); border-color: rgb(47, 107, 79); }
.dk-chip-text { font-size: 17px; margin-left: 6px; color: rgb(31, 42, 68); }
.dk-chip-icon { width: 26px; height: 26px; margin-left: 6px; }
.dk-chip-tpl { padding-left: 12px; }
.dk-chip-tpl .dk-chip-text { margin-left: 0; }
.dk-picker { flex-direction: row; flex-wrap: wrap; }
.dk-pick { align-items: center; background-color: rgb(250, 247, 238); border-radius: 12px; border-width: 2px; border-color: rgba(31, 42, 68, 0.25); border-bottom-width: 4px; padding: 8px 12px; margin: 0 8px 8px 0; min-width: 96px; }
.dk-pick:hover { background-color: rgb(255, 244, 205); }
.dk-pick-on { background-color: rgb(214, 240, 222); border-color: rgb(47, 107, 79); border-width: 3px; }
.dk-pick-name { font-size: 17px; margin-top: 4px; color: rgb(31, 42, 68); }
.dk-pick-away { opacity: 0.6; }
.dk-pick-away-tag { font-size: 12px; color: rgb(107, 111, 128); }
.dk-pick-check { position: absolute; right: 4px; top: 4px; width: 22px; height: 22px; opacity: 0; }
.dk-pick-on .dk-pick-check { opacity: 1; }

/* ---------------------------------------------------------------- Messages / Mail */
.dk-msg-row { flex-direction: row; flex-grow: 1; }
.dk-msg-list { width: 300px; margin-right: 14px; }
.dk-mail-left { width: 320px; margin-right: 14px; }
.dk-mail-new { margin: 0 0 8px 0; }
.dk-msg-right { flex-grow: 1; flex-shrink: 1; }
.dk-thread { flex-direction: row; align-items: center; background-color: rgb(255, 253, 247); border-radius: 10px; border-width: 2px; border-color: rgba(31, 42, 68, 0.2); border-bottom-width: 3px; padding: 6px 8px; margin-bottom: 6px; }
.dk-thread:hover { background-color: rgb(255, 244, 205); }
.dk-thread-on { background-color: rgb(214, 240, 222); border-color: rgb(47, 107, 79); }
.dk-thread-col { margin-left: 8px; flex-grow: 1; flex-shrink: 1; }
.dk-thread-name { font-size: 18px; color: rgb(31, 42, 68); }
.dk-thread-prev { font-size: 14px; color: rgb(107, 111, 128); white-space: normal; max-height: 38px; overflow: hidden; }
.dk-mailrow-unread .dk-thread-name { color: rgb(210, 56, 47); }
.dk-msg-head, .dk-mail-head { flex-direction: row; align-items: center; padding-bottom: 6px; border-bottom-width: 2px; border-color: rgba(31, 42, 68, 0.15); }
.dk-msg-head-col { margin-left: 10px; }
.dk-msg-head-name { font-size: 28px; color: rgb(31, 42, 68); }
.dk-msg-head-sub { font-size: 14px; color: rgb(107, 111, 128); }
.dk-msg-left { font-size: 15px; color: rgb(107, 111, 128); margin-right: 10px; }
.dk-msg-convo { flex-grow: 1; margin: 8px 0; }
.dk-bubble-row { flex-direction: row; margin-bottom: 8px; }
.dk-bubble-row-me { justify-content: flex-end; }
.dk-bubble-row-them { justify-content: flex-start; }
.dk-msgbubble { max-width: 75%; padding: 8px 14px 6px 14px; border-radius: 16px; border-width: 2px; border-color: rgb(31, 42, 68); border-bottom-width: 4px; }
.dk-msgbubble-me { background-color: rgb(214, 240, 222); border-bottom-right-radius: 4px; }
.dk-msgbubble-them { background-color: rgb(255, 253, 247); border-bottom-left-radius: 4px; }
.dk-msgbubble-text { font-size: 19px; white-space: normal; color: rgb(31, 42, 68); }
.dk-msgbubble-time { font-size: 12px; color: rgb(107, 111, 128); -unity-text-align: middle-right; }
.dk-mail-subject { font-size: 26px; color: rgb(31, 42, 68); flex-shrink: 1; margin-right: 10px; }
.dk-mailcard { background-color: rgb(255, 253, 247); border-radius: 8px; border-width: 2px; border-color: rgba(31, 42, 68, 0.25); padding: 10px 14px; margin-bottom: 8px; }
.dk-mailcard-me { background-color: rgb(236, 244, 232); }
.dk-mailcard-mgr { background-color: rgb(255, 238, 186); }
.dk-mailcard-sys { background-color: rgb(226, 232, 244); }
.dk-mailcard-head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.dk-mailcard-col { margin-left: 8px; }
.dk-mailcard-from { font-size: 19px; color: rgb(31, 42, 68); }
.dk-mailcard-meta { font-size: 13px; color: rgb(107, 111, 128); }
.dk-mailcard-text { font-size: 19px; white-space: normal; color: rgb(31, 42, 68); }
.dk-mail-reply { margin: 0; }
.dk-mail-compose { max-height: 62%; }
.dk-mail-to { flex-direction: row; align-items: center; margin-bottom: 4px; }
.dk-mail-to-label { font-size: 17px; color: rgb(107, 111, 128); margin-right: 8px; }
.dk-mail-to-name { font-size: 19px; color: rgb(31, 42, 68); }
.dk-mail-torow { margin-bottom: 4px; }
.dk-mail-tpl { margin-bottom: 4px; }
.dk-mail-tpl-label { font-size: 15px; color: rgb(107, 111, 128); margin-bottom: 2px; }

/* ---------------------------------------------------------------- Complaint */
.dk-complaint-scroll { flex-grow: 1; }
.dk-anon { flex-direction: row; align-items: center; background-color: rgb(31, 42, 68); border-radius: 12px; padding: 10px 16px; margin-bottom: 8px; }
.dk-anon-icon { width: 48px; height: 48px; margin-right: 12px; }
.dk-anon-col { flex-shrink: 1; }
.dk-anon-band { font-size: 22px; color: rgb(255, 224, 102); letter-spacing: 2px; }
.dk-anon-text { font-size: 16px; color: rgb(244, 239, 227); white-space: normal; }
.dk-presets { flex-direction: row; flex-wrap: wrap; }
.dk-preset { flex-direction: row; align-items: center; width: 48%; margin-right: 2%; margin-bottom: 6px; background-color: rgb(250, 247, 238); border-radius: 10px; border-width: 2px; border-color: rgba(31, 42, 68, 0.3); border-bottom-width: 4px; padding: 8px 12px; }
.dk-preset:hover { background-color: rgb(255, 244, 205); }
.dk-preset-text { font-size: 18px; color: rgb(31, 42, 68); white-space: normal; flex-shrink: 1; }
.dk-complaint-preview { background-color: rgb(255, 247, 200); border-radius: 3px; padding: 8px 14px 10px 14px; margin-top: 8px; rotate: 1deg; }
.dk-complaint-preview-text { font-size: 21px; white-space: normal; color: rgb(31, 42, 68); }

/* ---------------------------------------------------------------- Bank */
.dk-bank-scroll { flex-grow: 1; }
.dk-bank-top { flex-direction: row; align-items: stretch; }
.dk-bank-balance { background-color: rgb(31, 42, 68); border-radius: 14px; padding: 12px 24px; margin-right: 14px; align-items: center; justify-content: center; min-width: 260px; }
.dk-bank-band { font-size: 18px; color: rgb(232, 201, 138); letter-spacing: 2px; }
.dk-bank-amount { font-size: 44px; color: rgb(196, 232, 170); }
.dk-bank-income { flex-grow: 1; background-color: rgb(255, 253, 247); border-radius: 12px; border-width: 2px; border-color: rgba(31, 42, 68, 0.25); padding: 10px 16px; }
.dk-bank-income-title { font-size: 18px; color: rgb(31, 42, 68); }
.dk-incbar { height: 20px; background-color: rgba(31, 42, 68, 0.15); border-radius: 10px; border-width: 2px; border-color: rgb(31, 42, 68); margin-top: 6px; }
.dk-incbar-fill { height: 100%; background-color: rgb(47, 107, 79); border-radius: 8px; }
.dk-incbar-fill-half { background-color: rgb(210, 160, 47); }
.dk-incbar-fill-cap { background-color: rgb(210, 56, 47); }
.dk-incbar-mark { position: absolute; top: -5px; width: 4px; height: 26px; margin-left: -2px; background-color: rgb(31, 42, 68); }
.dk-bank-income-text { font-size: 20px; color: rgb(31, 42, 68); margin-top: 4px; }
.dk-bank-income-rule { font-size: 15px; color: rgb(60, 66, 84); white-space: normal; }
.dk-amount { flex-direction: row; align-items: center; margin-top: 4px; }
.dk-amount-label { font-size: 19px; margin-right: 12px; color: rgb(31, 42, 68); }
.dk-amount-btn { width: 46px; height: 46px; min-width: 46px; margin: 0; padding: 0; font-size: 26px; }
.dk-amount-value { font-size: 36px; min-width: 70px; -unity-text-align: middle-center; color: rgb(31, 42, 68); }
.dk-bank-rule { font-size: 14px; color: rgb(107, 111, 128); white-space: normal; margin-top: 2px; }
.dk-hist { flex-direction: row; align-items: center; background-color: rgb(255, 253, 247); border-radius: 8px; border-width: 2px; border-color: rgba(31, 42, 68, 0.15); padding: 5px 10px; margin-bottom: 4px; }
.dk-hist-icon { width: 30px; height: 30px; margin-right: 8px; }
.dk-hist-col { flex-shrink: 1; }
.dk-hist-name { font-size: 18px; color: rgb(31, 42, 68); }
.dk-hist-time { font-size: 13px; color: rgb(107, 111, 128); }
.dk-hist-amount { font-size: 22px; color: rgb(47, 107, 79); }
.dk-hist-out .dk-hist-amount { color: rgb(210, 56, 47); }

/* ---------------------------------------------------------------- Evidence */
.dk-ev-tabs { margin-bottom: 8px; }
.dk-ev-scroll { flex-grow: 1; }
.dk-rec-grid { flex-direction: row; flex-wrap: wrap; }
.dk-rec { background-color: rgb(255, 253, 247); border-radius: 8px; border-width: 2px; border-color: rgb(31, 42, 68); border-bottom-width: 5px; padding: 8px 12px 10px 12px; margin: 0 10px 10px 0; width: 300px; }
.dk-rec-tile { width: 31%; min-width: 280px; }
.dk-rec:hover { background-color: rgb(255, 250, 235); }
.dk-rec-proof { border-color: rgb(210, 56, 47); background-color: rgb(255, 240, 234); }
.dk-rec-presented { opacity: 0.8; }
.dk-rec-head { flex-direction: row; align-items: center; }
.dk-rec-icon { width: 34px; height: 34px; margin-right: 8px; }
.dk-rec-col { flex-shrink: 1; }
.dk-rec-kind { font-size: 19px; color: rgb(31, 42, 68); }
.dk-rec-prov { font-size: 12px; color: rgb(107, 111, 128); white-space: normal; }
.dk-rec-text { font-size: 17px; color: rgb(31, 42, 68); white-space: normal; margin-top: 6px; }
.dk-rec-tags { flex-direction: row; margin-top: 6px; }
.dk-evidence-foot { font-size: 14px; color: rgb(107, 111, 128); white-space: normal; margin-top: 6px; }
.dk-ev-info { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 6px; }
.dk-ev-info-chip { font-size: 16px; background-color: rgb(255, 224, 102); border-radius: 4px; padding: 3px 10px; margin-right: 8px; color: rgb(31, 42, 68); }
.dk-ev-info-rule { font-size: 14px; color: rgb(107, 111, 128); white-space: normal; flex-shrink: 1; }
.dk-offer { flex-direction: row; align-items: center; background-color: rgb(255, 253, 247); border-radius: 12px; border-width: 2px; border-color: rgba(31, 42, 68, 0.3); border-bottom-width: 4px; padding: 8px 12px; margin-bottom: 8px; }
.dk-offer-bought { background-color: rgb(226, 243, 230); }
.dk-offer-icon { width: 44px; height: 44px; margin-right: 12px; }
.dk-offer-col { flex-grow: 1; flex-shrink: 1; }
.dk-offer-name { font-size: 20px; color: rgb(31, 42, 68); white-space: normal; }
.dk-offer-desc { font-size: 14px; color: rgb(107, 111, 128); white-space: normal; }
.dk-offer-why { font-size: 14px; color: rgb(210, 56, 47); white-space: normal; }
.dk-offer-price { font-size: 22px; margin: 0 12px; color: rgb(31, 42, 68); }

/* ---------------------------------------------------------------- Remedial / Trick */
.dk-rem-scroll, .dk-trick-scroll { flex-grow: 1; }
.dk-rem-info { flex-direction: row; background-color: rgb(236, 244, 232); border-radius: 12px; padding: 10px 16px; margin-bottom: 10px; }
.dk-rem-info-icon { width: 54px; height: 54px; margin-right: 14px; }
.dk-rem-info-col { flex-shrink: 1; }
.dk-rem-title { font-size: 28px; color: rgb(31, 42, 68); }
.dk-rem-text { font-size: 17px; white-space: normal; color: rgb(31, 42, 68); }
.dk-rem-caps { font-size: 14px; color: rgb(107, 111, 128); }
.dk-rem-card { flex-direction: row; align-items: center; border-radius: 12px; border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 6px; padding: 10px 14px; margin-bottom: 10px; }
.dk-rem-incoming { background-color: rgb(255, 238, 186); }
.dk-rem-outgoing { background-color: rgb(250, 247, 238); }
.dk-rem-col { margin: 0 12px; flex-grow: 1; flex-shrink: 1; }
.dk-rem-card-title { font-size: 22px; color: rgb(31, 42, 68); white-space: normal; }
.dk-rem-card-sub { font-size: 15px; color: rgb(60, 66, 84); white-space: normal; }
.dk-rem-timer { font-size: 28px; color: rgb(210, 56, 47); margin-right: 12px; }
.dk-trick-top { flex-direction: row; align-items: flex-start; margin-bottom: 8px; }
.dk-trick-card { margin-right: 20px; }
.dk-trick-col { flex-grow: 1; flex-shrink: 1; }
.dk-trick-name { font-size: 40px; color: rgb(31, 42, 68); }
.dk-trick-how { font-size: 19px; white-space: normal; color: rgb(31, 42, 68); margin-top: 4px; }
.dk-trick-warn { flex-direction: row; align-items: center; background-color: rgb(255, 236, 228); border-radius: 10px; border-width: 2px; border-color: rgb(210, 56, 47); padding: 8px 12px; margin-top: 10px; }
.dk-trick-warn-icon { width: 36px; height: 36px; margin-right: 10px; }
.dk-trick-warn-text { font-size: 16px; white-space: normal; flex-shrink: 1; color: rgb(31, 42, 68); }

/* ---------------------------------------------------------------- centre cards: slot position for the break, break + reveal */
.dk-cards-slot-low { justify-content: flex-end; padding-bottom: 28px; }
.dk-break { width: 1100px; background-color: rgb(244, 239, 227); border-radius: 20px; border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 9px; padding: 14px 24px 18px 24px; }
.dk-break-head { flex-direction: row; align-items: center; }
.dk-break-timer { font-size: 34px; color: rgb(31, 42, 68); }
.dk-break-title { font-size: 38px; color: rgb(31, 42, 68); margin-top: 4px; }
.dk-break-carried { font-size: 18px; color: rgb(47, 107, 79); white-space: normal; }
.dk-break-sub { font-size: 17px; color: rgb(60, 66, 84); white-space: normal; margin-bottom: 8px; }
.dk-break-grid { flex-direction: row; flex-wrap: wrap; }
.dk-break-act { flex-direction: row; align-items: center; width: 31.5%; margin-right: 1.5%; margin-bottom: 8px; background-color: rgb(255, 253, 247); border-radius: 12px; border-width: 2px; border-color: rgba(31, 42, 68, 0.3); border-bottom-width: 5px; padding: 8px 12px; }
.dk-break-act:hover { background-color: rgb(255, 244, 205); }
.dk-break-act:disabled { opacity: 0.45; }
.dk-break-act-icon { width: 44px; height: 44px; margin-right: 10px; }
.dk-break-act-col { flex-shrink: 1; }
.dk-break-act-title { font-size: 20px; color: rgb(31, 42, 68); }
.dk-break-act-sub { font-size: 13px; color: rgb(107, 111, 128); white-space: normal; }

.dk-reveal { width: 1200px; background-color: rgb(244, 239, 227); border-radius: 24px; border-width: 3px; border-color: rgb(31, 42, 68); border-bottom-width: 9px; padding: 20px 30px 16px 30px; }
.dk-reveal-head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.dk-reveal-iconbox { width: 74px; height: 74px; border-radius: 16px; align-items: center; justify-content: center; margin-right: 14px; border-width: 3px; border-color: rgb(31, 42, 68); }
.dk-reveal-icon { width: 52px; height: 52px; }
.dk-reveal-headcol { flex-shrink: 1; }
.dk-reveal-title { font-size: 44px; color: rgb(31, 42, 68); margin-top: -6px; }
.dk-reveal-stamp, .dk-reveal-stamp-green { margin-left: 10px; }
.dk-reveal-out { flex-direction: row; align-items: center; margin: 6px 0 10px 0; }
.dk-reveal-num { font-size: 74px; color: rgb(31, 42, 68); }
.dk-reveal-max { font-size: 34px; color: rgb(107, 111, 128); margin: 20px 20px 0 8px; }
.dk-reveal-outcol { flex-grow: 1; }
.dk-reveal-bar { height: 22px; background-color: rgba(31, 42, 68, 0.15); border-radius: 11px; border-width: 2px; border-color: rgb(31, 42, 68); }
.dk-reveal-bar .dk-gauge-fill, .dk-reveal-bar .bar-fill { height: 100%; background-color: rgb(47, 107, 79); border-radius: 9px; }
.dk-reveal-company { font-size: 19px; color: rgb(60, 66, 84); white-space: normal; margin-top: 6px; }
.dk-reveal-body { flex-direction: row; min-height: 150px; }
.dk-reveal-col { flex-grow: 1; flex-basis: 0; margin-right: 20px; background-color: rgb(255, 253, 247); border-radius: 8px; border-width: 2px; border-color: rgba(31, 42, 68, 0.2); padding: 8px 12px; }
.dk-reveal-colband { font-size: 16px; color: rgb(210, 56, 47); letter-spacing: 2px; margin-bottom: 4px; }
.dk-ballot { flex-direction: row; align-items: center; margin-bottom: 3px; }
.dk-ballot-who { font-size: 17px; margin-left: 8px; color: rgb(31, 42, 68); }
.dk-ballot-what { font-size: 17px; color: rgb(47, 107, 79); }
.dk-reveal-miss { flex-direction: row; align-items: center; margin-top: 8px; background-color: rgb(255, 236, 228); border-radius: 8px; padding: 6px 12px; }
.dk-reveal-miss-icon { width: 30px; height: 30px; margin-right: 8px; }
.dk-reveal-miss-text { font-size: 17px; color: rgb(31, 42, 68); white-space: normal; flex-shrink: 1; }
.dk-reveal-mine { flex-direction: row; align-items: center; margin-top: 10px; }
.dk-reveal-mine-chip { font-size: 17px; background-color: rgb(255, 224, 102); border-radius: 4px; padding: 3px 10px; margin-right: 10px; color: rgb(31, 42, 68); }
.dk-reveal-next { font-size: 16px; color: rgb(107, 111, 128); margin-left: auto; }

/* ---------------------------------------------------------------- phone additions */
.dk-phone-miss { flex-direction: row; align-items: center; background-color: rgb(255, 238, 186); border-radius: 12px; border-width: 2px; border-color: rgb(31, 42, 68); padding: 6px 10px; margin-top: 10px; }
.dk-miss-icon { width: 34px; height: 34px; margin-right: 6px; }
.dk-miss-col { margin-left: 8px; flex-shrink: 1; }
.dk-miss-title { font-size: 18px; color: rgb(31, 42, 68); white-space: normal; }
.dk-miss-sub { font-size: 13px; color: rgb(60, 66, 84); white-space: normal; }
.dk-dial-row { padding: 0; }
.dk-dial-callarea { flex-direction: row; align-items: center; flex-grow: 1; padding: 6px 4px; }
.dk-dial-callarea:hover { background-color: rgba(255, 224, 102, 0.3); }
.dk-dial-callarea:disabled { opacity: 0.45; }
.dk-dial-text { margin: 0 0 0 6px; }
