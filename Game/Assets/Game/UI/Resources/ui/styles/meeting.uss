/* v5 meeting room layer, steps 3a and 3b (MeetingUi.cs, MeetingSlide.cs, MeetingFolder.cs, MeetingBallot.cs, MeetingBoard.cs;
   the projector has its own sheet: projector.uss).
   Logical 1920x1080 (scaled). Shares the office strip, toasts and prompt (office.uss) and the play blocks (play.uss).
   Palette: paper #F4EFE3, ink navy #1F2A44, stamp red #D2382F, HR teal #3BB9B0, marker yellow #FFE066. */

.mt-screen { color: rgb(31, 42, 68); font-size: 20px; }

/* ---------------------------------------------------------------- step 3b: what stays on screen of the public card */
/* the results bar (MeetingSlide.cs): my place and the buttons; the ceremony itself is on the projector */
.mt-results { position: absolute; left: 50%; bottom: 22px; translate: -50% 0; max-width: 1600px; align-items: center;
    background-color: rgba(23, 31, 52, 0.9); border-radius: 18px; border-width: 2px; border-color: rgba(244, 239, 227, 0.2); padding: 10px 18px 4px 18px; }
.mt-results-top { flex-direction: row; align-items: center; justify-content: center; margin: 0 0 6px 0; }
.mt-results-line { font-size: 22px; color: rgb(255, 224, 102); margin: 0; -unity-text-align: middle-center; white-space: normal; }
.mt-results-buttons { flex-direction: row; justify-content: center; }
.mt-results .pl-wrap { justify-content: center; }
.mt-results .pl-btn { margin: 0 6px 8px 6px; }
.mt-results-reveal { border-color: rgb(255, 224, 102); }
.mt-results-abandoned { bottom: auto; top: 42%; }
/* back from the projector zoom; "on the projector" while something happens there out of view */
.mt-pj-back { bottom: 64px; }
.mt-pj-hint { position: absolute; left: 26px; bottom: 76px; flex-direction: row; align-items: center; padding: 7px 16px 7px 12px;
    border-radius: 16px; background-color: rgba(23, 31, 52, 0.84); border-width: 2px; border-color: rgba(255, 224, 102, 0.75); }
.mt-pj-hint-lamp { width: 12px; height: 12px; border-radius: 6px; background-color: rgb(255, 90, 70); margin-right: 10px; }
.mt-pj-hint-text { font-size: 19px; color: rgb(244, 239, 227); }

/* ---------------------------------------------------------------- a colleague's name tag under the crosshair */
.mt-name { position: absolute; top: 56%; left: 50%; translate: -50% 0; align-items: center; background-color: rgba(23, 31, 52, 0.72);
    border-radius: 14px; padding: 2px 16px 5px 16px; }
.mt-name-text { font-size: 28px; }
.mt-name-info { font-size: 17px; color: rgb(220, 226, 240); }
.mt-name-act { font-size: 16px; color: rgb(255, 224, 102); margin-top: 1px; }

/* ---------------------------------------------------------------- the folder's tablet (laid over the tablet screen) */
.mt-tablet { overflow: hidden; border-radius: 8px; background-color: rgb(250, 247, 238); flex-direction: column; color: rgb(31, 42, 68); }
.mt-tabs { flex-direction: row; align-items: center; height: 62px; flex-shrink: 0; background-color: rgb(31, 42, 68); padding: 0 10px 0 14px; }
.mt-tabs-brand { font-size: 19px; color: rgb(255, 224, 102); letter-spacing: 2px; margin-right: 14px; }
.mt-tab { background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 12px; padding: 7px 16px; margin: 0 4px 0 0; flex-shrink: 0; }
.mt-tab-text { font-size: 19px; color: rgb(244, 239, 227); white-space: nowrap; }
.mt-tab:hover { background-color: rgba(244, 239, 227, 0.14); }
.mt-tab-on { background-color: rgb(255, 224, 102); }
.mt-tab-on .mt-tab-text { color: rgb(31, 42, 68); }
.mt-tab-on:hover { background-color: rgb(255, 230, 128); }
.mt-tab-badge { position: absolute; top: -4px; right: -6px; background-color: rgb(210, 56, 47); color: rgb(255, 255, 255); border-radius: 11px;
    min-width: 22px; height: 22px; font-size: 13px; -unity-text-align: middle-center; padding: 0 5px; border-width: 2px; border-color: rgb(31, 42, 68); }
.mt-tabs-prim { font-size: 18px; color: rgb(255, 224, 102); margin-right: 14px; }
.mt-tabs-clock { font-size: 25px; color: rgb(255, 224, 102); margin-right: 12px; }
.mt-tablet-title { font-size: 15px; color: rgb(107, 111, 128); letter-spacing: 2px; padding: 8px 22px 0 22px; flex-shrink: 0; }
.mt-tablet-body { flex-grow: 1; flex-shrink: 1; }
.mt-tablet-section { padding: 6px 22px 16px 22px; }
.mt-tablet-foot { font-size: 14px; color: rgb(107, 111, 128); -unity-text-align: middle-center; padding: 3px 0 5px 0; flex-shrink: 0;
    border-top-width: 1px; border-color: rgba(31, 42, 68, 0.12); }
.mt-compose { flex-shrink: 0; }
.mt-card { margin-bottom: 12px; padding: 10px 16px 12px 16px; }
.mt-rec { align-items: center; margin-top: 4px; }
.mt-msg-chat { border-color: rgba(59, 185, 176, 0.6); }
.mt-tablet .pl-title { color: rgb(31, 42, 68); }
.mt-tablet .pl-sub { color: rgb(31, 42, 68); }
.mt-tablet .pl-text { color: rgb(46, 56, 82); white-space: normal; font-size: 19px; }
.mt-tablet .pl-dim { color: rgb(110, 116, 136); }
.mt-tablet .pl-good { color: rgb(36, 120, 74); }
.mt-tablet .pl-bad { color: rgb(190, 50, 42); }
.mt-tablet .pl-warn { color: rgb(184, 104, 20); }
.mt-tablet .pl-private { color: rgb(86, 64, 160); }
.mt-tablet .pl-amount { color: rgb(31, 42, 68); }
.mt-tablet .pl-focus { background-color: rgb(255, 250, 235); border-color: rgba(31, 42, 68, 0.3); }
.mt-tablet .pl-focus-todo { border-color: rgb(232, 140, 40); background-color: rgb(255, 243, 222); }
.mt-tablet .pl-focus-kicker { color: rgb(150, 90, 30); }
.mt-tablet .pl-focus-text { color: rgb(31, 42, 68); white-space: normal; font-size: 21px; }
.mt-tablet .pl-chip { background-color: rgba(31, 42, 68, 0.1); color: rgb(31, 42, 68); }
.mt-tablet .pl-chip-bad { background-color: rgba(210, 56, 47, 0.2); }
.mt-tablet .pl-chip-good { background-color: rgba(36, 120, 74, 0.22); }
.mt-tablet .pl-award-chip { background-color: rgba(210, 56, 47, 0.18); color: rgb(170, 40, 34); }
.mt-tablet .pl-headline { color: rgb(31, 42, 68); font-size: 20px; }
.mt-tablet .pl-chip-warn { background-color: rgba(232, 140, 40, 0.25); }
.mt-tablet .pl-tag { background-color: rgba(31, 42, 68, 0.8); }
.mt-tablet .pl-fire { background-color: rgba(210, 56, 47, 0.08); }
.mt-tablet .pl-fire-title { color: rgb(190, 50, 42); }
.mt-tablet .pl-fire-desk { color: rgb(150, 90, 30); }

/* ---------------------------------------------------------------- the ballot paper (592 x 840; texture and overlay) */
.mt-paper { width: 592px; height: 840px; background-color: rgb(251, 248, 240); padding: 34px 40px 26px 40px; color: rgb(31, 42, 68); }
.mt-paper-live { border-width: 0; }
.mt-paper-title { font-size: 54px; color: rgb(31, 42, 68); -unity-text-align: middle-center; letter-spacing: 4px; margin: 0; }
.mt-paper-sub { font-size: 22px; color: rgb(110, 116, 136); -unity-text-align: middle-center; margin-top: -4px; }
.mt-paper-rule { height: 3px; background-color: rgba(31, 42, 68, 0.75); margin: 12px 0 10px 0; }
.mt-paper-how { font-size: 21px; color: rgb(70, 78, 100); white-space: normal; margin-bottom: 8px; }
.mt-paper-cols { flex-direction: row; justify-content: flex-end; margin-top: 2px; }
.mt-paper-col { width: 64px; font-size: 18px; color: rgb(110, 116, 136); -unity-text-align: middle-center; margin-left: 12px; }
.mt-paper-rows { margin-top: 2px; }
.mt-paper-row { flex-direction: row; align-items: center; height: 72px; border-bottom-width: 2px; border-color: rgba(70, 120, 190, 0.38); }
.mt-paper-row-abstain { border-top-width: 2px; border-top-color: rgba(31, 42, 68, 0.5); margin-top: 6px; }
.mt-paper-row-abstain .mt-paper-name { color: rgb(110, 116, 136); }
.mt-paper-dot { width: 18px; height: 18px; border-radius: 9px; margin-right: 14px; border-width: 2px; border-color: rgba(31, 42, 68, 0.35); }
.mt-paper-dot-none { background-color: rgba(0, 0, 0, 0); }
.mt-paper-name { font-size: 42px; color: rgb(31, 42, 68); flex-grow: 1; flex-shrink: 1; margin: 0; padding: 0; white-space: nowrap; overflow: hidden; }
.mt-paper-box { width: 52px; height: 52px; border-width: 3px; border-color: rgb(31, 42, 68); border-radius: 4px; margin: 0 6px 0 18px;
    align-items: center; justify-content: center; background-color: rgba(255, 255, 255, 0.5); padding: 0; }
.mt-paper-box:hover { background-color: rgba(255, 224, 102, 0.55); border-color: rgb(210, 140, 30); }
.mt-paper-x { font-size: 62px; color: rgb(54, 58, 74); margin: -6px 0 0 0; padding: 0; -unity-text-align: middle-center; rotate: -6deg; }
/* step 3b: the pencil draws the newest X (MeetingBallot.DrawX) */
.mt-paper-xclip { position: absolute; left: 0; top: 0; bottom: 0; overflow: hidden; align-items: flex-start; justify-content: center; }
.mt-paper-x-drawn { width: 46px; }
.mt-paper-pen { position: absolute; width: 12px; height: 66px; background-color: rgb(244, 196, 48); border-radius: 3px; border-width: 2px;
    border-color: rgb(120, 84, 20); rotate: 28deg; transform-origin: 50% 100%; }
.mt-paper-pen-tip { position: absolute; bottom: -10px; left: 1px; width: 6px; height: 12px; background-color: rgb(232, 196, 150); border-radius: 0 0 3px 3px; }
.mt-paper-foot { position: absolute; left: 40px; right: 40px; bottom: 22px; }
.mt-paper-cast { font-size: 20px; color: rgb(36, 120, 74); border-width: 3px; border-color: rgba(36, 120, 74, 0.8); border-radius: 8px;
    padding: 3px 10px; align-self: flex-start; rotate: -2deg; margin-bottom: 6px; white-space: normal; }
.mt-paper-foot .oc-buttons .pl-btn { margin-right: 10px; }

/* ---------------------------------------------------------------- whiteboard (1024 x 512, marker on white) */
.wb-root { background-color: rgb(250, 250, 246); }
.wb-title { font-size: 48px; color: rgb(31, 42, 68); margin: 0; padding: 0; }
.wb-underline { background-color: rgba(200, 52, 44, 0.85); border-radius: 2px; rotate: -0.6deg; }
.wb-row { flex-direction: row; align-items: center; }
.wb-dot { width: 26px; height: 26px; border-radius: 13px; margin-right: 12px; border-width: 2px; border-color: rgba(31, 42, 68, 0.4); }
.wb-name { font-size: 42px; width: 190px; margin: 0; padding: 0; white-space: nowrap; overflow: hidden; }
.wb-me { font-size: 28px; color: rgb(200, 52, 44); margin: 0 8px 0 -8px; rotate: 6deg; }
.wb-struck { opacity: 0.55; }
.wb-tally { flex-direction: row; align-items: center; width: 200px; height: 46px; }
.wb-group { flex-direction: row; align-items: center; margin-right: 12px; height: 44px; }
.wb-bar { width: 5px; height: 38px; background-color: rgb(200, 52, 44); border-radius: 2px; margin-right: 6px; }
.wb-slash { position: absolute; left: -6px; top: 18px; width: 50px; height: 5px; background-color: rgb(200, 52, 44); border-radius: 2px; rotate: -24deg; }
.wb-num { font-size: 44px; color: rgb(70, 78, 100); width: 52px; margin: 0; padding: 0; -unity-text-align: middle-left; }
.wb-num-on { color: rgb(200, 52, 44); }
.wb-plus { font-size: 32px; color: rgb(214, 110, 20); margin: 0 8px 0 0; padding: 0; }
.wb-stamp { font-size: 22px; border-width: 3px; border-radius: 4px; padding: 0 6px; margin: 0 6px 0 0; rotate: -3deg; }
.wb-stamp-cand { color: rgb(214, 110, 20); border-color: rgb(214, 110, 20); }
.wb-stamp-sealed { color: rgb(31, 42, 68); border-color: rgb(31, 42, 68); rotate: 2deg; }
.wb-stamp-fired { color: rgb(200, 52, 44); border-color: rgb(200, 52, 44); }
.wb-voted { font-size: 26px; color: rgb(36, 120, 74); margin: 0; padding: 0; }
.wb-side { padding-left: 18px; border-left-width: 3px; border-color: rgba(47, 95, 180, 0.55); }
.wb-side-head { font-size: 36px; color: rgb(47, 95, 180); margin: 0 0 6px 0; padding: 0; white-space: normal; }
.wb-side-sub { font-size: 28px; color: rgb(70, 78, 100); margin: 4px 0 0 0; padding: 0; }
.wb-side-line { font-size: 34px; color: rgb(31, 42, 68); margin: 0; padding: 0; white-space: normal; }
.wb-side-bad { color: rgb(200, 52, 44); }
.wb-side-good { color: rgb(36, 120, 74); }
.wb-side-hot { -unity-font-style: bold; }
.wb-side-note { font-size: 28px; color: rgb(70, 78, 100); margin-top: 10px; padding: 0; white-space: normal; }

/* ---------------------------------------------------------------- v5 bot talk: a bot's chat line over its head (MeetingSubtitles.cs) */
.mt-sub { position: absolute; translate: -50% -100%; max-width: 520px; align-items: center; background-color: rgba(252, 248, 238, 0.96);
    border-radius: 16px; border-width: 3px; border-bottom-width: 5px; border-color: rgb(31, 42, 68); padding: 6px 14px 8px 14px; }
.mt-sub-who { font-size: 15px; letter-spacing: 1px; margin: 0 0 1px 0; }
.mt-sub-text { font-size: 20px; color: rgb(31, 42, 68); white-space: normal; -unity-text-align: middle-center; margin: 0; }
/* the defence: a subtitle over the standing character, in the spotlight's yellow */
.mt-sub-defence { max-width: 700px; border-color: rgb(255, 214, 90); background-color: rgba(23, 31, 52, 0.92); padding: 10px 20px 12px 20px; }
.mt-sub-defence .mt-sub-text { font-size: 26px; color: rgb(255, 246, 214); }
.mt-sub-defence .mt-sub-who { font-size: 17px; }
/* out of view: at the bottom of the screen like a film subtitle */
.mt-sub-screen { left: 50%; top: auto; bottom: 110px; translate: -50% 0; }
/* (3b polish) zoomed on the projector the corner notes start under its header and clock */
.mt-toasts-zoom { top: 182px; }

/* ---------------------------------------------------------------- v5 Yaramazlıklar (MeetingPranks.cs, MeetingSubtitles.cs) */
/* the manager's line over his head */
.mt-sub-manager { border-color: rgb(160, 40, 30); background-color: rgba(255, 246, 238, 0.97); }
/* aiming: the name tag of whoever the prank would hit */
.mt-name-aim { border-width: 3px; border-color: rgb(255, 140, 60); }
/* coffee / cream over my screen */
.pk-splash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
/* my own post-it (I cannot see my forehead) */
.pk-mypostit { position: absolute; top: 128px; left: 50%; translate: -50% 0; align-items: center; background-color: rgb(255, 232, 98);
    padding: 4px 22px 8px 22px; rotate: 3deg; border-bottom-width: 4px; border-color: rgba(176, 140, 20, 0.6); }
.pk-mypostit-kicker { font-size: 13px; color: rgb(120, 92, 20); letter-spacing: 2px; margin: 0; }
.pk-mypostit-word { font-size: 32px; color: rgb(31, 42, 68); margin: 0; }
/* the quick wheel (G) */
.pk-wheel { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(10, 14, 26, 0.5); }
.pk-ring { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
.pk-centre { position: absolute; left: -160px; top: -160px; width: 320px; height: 320px; border-radius: 160px; background-color: rgba(23, 31, 52, 0.95);
    border-width: 4px; border-color: rgb(255, 224, 102); align-items: center; justify-content: center; padding: 22px 26px; }
.pk-centre-title { font-size: 22px; color: rgb(255, 224, 102); letter-spacing: 3px; margin-bottom: 8px; }
.pk-centre-level { font-size: 19px; color: rgb(244, 239, 227); margin: 6px 0 4px 0; -unity-text-align: middle-center; white-space: normal; }
.pk-centre-info { font-size: 16px; color: rgb(214, 220, 236); white-space: normal; -unity-text-align: middle-center; }
.pk-slice { position: absolute; width: 270px; height: 96px; translate: -50% -50%; background-color: rgb(252, 248, 238); border-radius: 18px;
    border-width: 3px; border-bottom-width: 6px; border-color: rgb(31, 42, 68); padding: 6px 12px 6px 38px; align-items: center; justify-content: center; }
.pk-slice:hover { background-color: rgb(255, 240, 180); border-color: rgb(232, 140, 40); }
.pk-slice-on { background-color: rgb(255, 240, 180); border-color: rgb(232, 140, 40); }
.pk-slice-off { background-color: rgb(214, 216, 224); border-color: rgb(120, 126, 146); }
.pk-slice-off .pk-slice-name { color: rgb(96, 102, 122); }
.pk-slice-key { position: absolute; left: 8px; top: 6px; height: 26px; font-size: 15px; }
.pk-slice-name { font-size: 21px; color: rgb(31, 42, 68); margin: 0; -unity-text-align: middle-center; }
.pk-slice-info { font-size: 15px; color: rgb(80, 86, 108); white-space: normal; -unity-text-align: middle-center; margin: 2px 0 0 0; }
.pk-slice-off .pk-slice-info { color: rgb(170, 50, 40); }
.pk-wheel-foot { position: absolute; bottom: 70px; left: 50%; translate: -50% 0; font-size: 18px; color: rgb(244, 239, 227);
    background-color: rgba(23, 31, 52, 0.88); padding: 6px 18px; border-radius: 14px; }
/* the patience gauge: the manager's face and the notches (the wheel's centre, the folder's tab) */
.pk-gauge { flex-direction: row; align-items: center; }
.pk-face { width: 46px; height: 46px; border-radius: 23px; border-width: 4px; border-color: rgb(70, 170, 100); background-color: rgb(250, 247, 238);
    -unity-background-scale-mode: scale-and-crop; }
.pk-face-1 { border-color: rgb(236, 170, 40); }
.pk-face-2 { border-color: rgb(214, 60, 46); }
.pk-notches { flex-direction: row; margin-left: 8px; }
.pk-notch { width: 14px; height: 26px; margin-left: 4px; border-radius: 3px; border-width: 2px; border-color: rgba(244, 239, 227, 0.55);
    background-color: rgba(244, 239, 227, 0.12); }
.pk-notch-0 { background-color: rgb(70, 170, 100); border-color: rgb(46, 120, 70); }
.pk-notch-1 { background-color: rgb(236, 170, 40); border-color: rgb(170, 110, 20); }
.pk-notch-2 { background-color: rgb(214, 60, 46); border-color: rgb(150, 36, 28); }
.mt-tablet .pk-notch { border-color: rgba(31, 42, 68, 0.35); background-color: rgba(31, 42, 68, 0.06); }
.mt-tablet .pk-notch-0 { background-color: rgb(70, 170, 100); border-color: rgb(46, 120, 70); }
.mt-tablet .pk-notch-1 { background-color: rgb(236, 170, 40); border-color: rgb(170, 110, 20); }
.mt-tablet .pk-notch-2 { background-color: rgb(214, 60, 46); border-color: rgb(150, 36, 28); }
.pk-gauge-big .pk-face { width: 68px; height: 68px; border-radius: 34px; border-width: 5px; }
.pk-gauge-big .pk-notch { width: 18px; height: 34px; margin-left: 5px; }
/* the folder's tab */
.pk-head-row { flex-direction: row; align-items: center; }
.pk-head-text { margin-left: 18px; flex-grow: 1; flex-shrink: 1; }
.pk-row { margin-bottom: 7px; padding: 7px 14px 8px 14px; border-radius: 10px; border-width: 2px; border-color: rgba(31, 42, 68, 0.16);
    background-color: rgb(255, 252, 244); }
.pk-row:hover { border-color: rgba(232, 140, 40, 0.7); }
.pk-row-open { border-color: rgb(232, 140, 40); background-color: rgb(255, 246, 226); }
.pk-row-off .pk-row-name { color: rgb(120, 124, 140); }
.pk-row-top { flex-direction: row; align-items: center; }
.pk-row-name { font-size: 21px; color: rgb(31, 42, 68); margin: 0; }
.mt-tablet .pk-chip-cost { background-color: rgba(210, 56, 47, 0.14); }
.mt-tablet .pk-chip-free { background-color: rgba(36, 120, 74, 0.18); }
.pk-row-reason { font-size: 16px; color: rgb(184, 52, 42); margin: 1px 0 0 0; }
.pk-row-desc { font-size: 17px; color: rgb(70, 78, 100); white-space: normal; margin: 4px 0 0 0; }
.pk-row-actions { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 6px; }
.pk-target { border-left-width: 7px; min-width: 96px; }
.pk-note-row { align-items: center; }
/* the post-it word / plane note card */
.pk-dialog { position: absolute; left: 50%; top: 46%; translate: -50% -50%; width: 780px; background-color: rgb(252, 248, 238); border-radius: 16px;
    border-width: 3px; border-bottom-width: 7px; border-color: rgb(31, 42, 68); padding: 16px 24px 16px 24px; }
.pk-dialog-title { font-size: 34px; color: rgb(31, 42, 68); margin: 0; }
.pk-dialog-info { font-size: 18px; color: rgb(80, 86, 108); white-space: normal; margin: 2px 0 8px 0; }
.pk-dialog-sub { font-size: 15px; color: rgb(107, 111, 128); letter-spacing: 2px; margin: 8px 0 2px 0; }
.pk-words { flex-direction: row; flex-wrap: wrap; }
.pk-word { font-size: 22px; min-width: 128px; min-height: 48px; margin: 4px 8px 4px 0; background-color: rgb(255, 232, 98); color: rgb(31, 42, 68);
    border-width: 2px; border-color: rgba(176, 140, 20, 0.6); rotate: -1deg; }
.pk-word-on { border-width: 4px; border-color: rgb(210, 56, 47); background-color: rgb(255, 214, 60); }
.pk-note-field { font-size: 22px; margin: 4px 0 6px 0; min-height: 44px; }
.pk-targets { flex-direction: row; flex-wrap: wrap; }
.pk-dialog-buttons { flex-direction: row; justify-content: flex-end; margin-top: 12px; }
/* v5.2: the prim declaration card of a candidate (MeetingDeclare) and its chip */
.dc-card { position: absolute; left: 50%; bottom: 150px; translate: -50% 0; width: 700px; background-color: rgb(252, 248, 238); border-radius: 16px;
    border-width: 3px; border-bottom-width: 7px; border-color: rgb(31, 42, 68); padding: 14px 24px 14px 24px; }
.dc-head { flex-direction: row; align-items: center; }
.dc-title { font-size: 32px; color: rgb(200, 52, 44); margin: 0; flex-grow: 1; letter-spacing: 2px; }
.dc-timer { font-size: 24px; color: rgb(31, 42, 68); margin: 0; background-color: rgba(31, 42, 68, 0.08); padding: 2px 12px; border-radius: 16px; }
.dc-timer-low { color: rgb(255, 255, 255); background-color: rgb(210, 56, 47); }
.dc-info { font-size: 18px; color: rgb(80, 86, 108); white-space: normal; margin: 4px 0 8px 0; }
.dc-stepper { flex-direction: row; align-items: center; justify-content: center; }
.dc-step { font-size: 30px; min-width: 70px; min-height: 60px; margin: 0 6px; background-color: rgb(52, 62, 92); }
.dc-step-big { background-color: rgb(86, 94, 116); }
.dc-value-box { width: 190px; height: 126px; margin: 0 12px; align-items: center; justify-content: center; background-color: rgb(255, 255, 255);
    border-width: 3px; border-color: rgb(31, 42, 68); border-radius: 10px; }
.dc-value { font-size: 70px; color: rgb(31, 42, 68); margin: -6px 0 -12px 0; -unity-text-align: middle-center; }
.dc-unit { font-size: 17px; color: rgb(107, 111, 128); letter-spacing: 3px; margin: 0; }
.dc-real { font-size: 20px; color: rgb(36, 120, 74); -unity-text-align: middle-center; margin: 8px 0 2px 0; }
.dc-real-lie { color: rgb(196, 102, 18); }
.dc-foot { flex-direction: row; align-items: center; margin-top: 6px; }
.dc-keys { font-size: 16px; color: rgb(107, 111, 128); flex-grow: 1; flex-shrink: 1; white-space: normal; margin: 0 10px 0 0; }
.dc-foot .pl-btn { margin: 0 0 0 10px; }
.dc-chip { position: absolute; left: 50%; bottom: 96px; translate: -50% 0; flex-direction: row; align-items: center; padding: 7px 18px 7px 12px;
    background-color: rgba(23, 31, 52, 0.9); border-radius: 22px; border-width: 2px; border-color: rgba(244, 239, 227, 0.4); }
.dc-chip-todo { border-color: rgb(255, 170, 60); }
.dc-chip-seal { width: 14px; height: 14px; border-radius: 7px; background-color: rgb(110, 200, 130); margin-right: 10px; }
.dc-chip-todo .dc-chip-seal { background-color: rgb(255, 170, 60); }
.dc-chip-text { font-size: 19px; color: rgb(244, 239, 227); margin: 0; }
/* v5.2: my award on the results bar */
/* (negative vertical margins: the card is taller than the place line, and the bar must not grow over the folder) */
.mt-award { flex-direction: row; align-items: center; margin: -4px 0 -4px 18px; padding: 1px 14px; background-color: rgba(252, 248, 238, 0.96); border-radius: 10px;
    border-width: 2px; border-color: rgb(31, 42, 68); }
.mt-award-kicker { font-size: 17px; color: rgb(80, 86, 108); margin: 0 10px 0 0; }
.mt-award-name { font-size: 23px; color: rgb(200, 52, 44); border-width: 3px; border-color: rgb(200, 52, 44); border-radius: 6px; padding: 0 8px; rotate: -2deg; margin: 0 12px 0 0; }
.mt-award-text { font-size: 17px; color: rgb(31, 42, 68); margin: 0; white-space: normal; max-width: 640px; }
/* aiming */
.pk-aim { position: absolute; bottom: 150px; left: 50%; translate: -50% 0; background-color: rgba(23, 31, 52, 0.9); border-width: 2px;
    border-color: rgb(255, 140, 60); border-radius: 18px; padding: 8px 22px; }
.pk-aim-text { font-size: 21px; color: rgb(244, 239, 227); }
/* a plane's note */
.pk-reader { position: absolute; left: 50%; top: 44%; translate: -50% -50%; width: 660px; background-color: rgb(253, 251, 245); border-radius: 6px;
    padding: 22px 32px 18px 32px; rotate: -1.5deg; border-bottom-width: 6px; border-color: rgba(0, 0, 0, 0.18); align-items: center; }
.pk-reader-kicker { font-size: 16px; color: rgb(107, 111, 128); letter-spacing: 3px; margin: 0; }
.pk-reader-from { font-size: 18px; color: rgb(107, 111, 128); margin: 2px 0 0 0; }
.pk-reader-text { font-size: 42px; color: rgb(31, 42, 68); white-space: normal; -unity-text-align: middle-center; margin: 14px 0 18px 0; }
/* the patience dots of a prank (filled: it adds; hollow: flattering takes away) */
.pk-dots-chip { flex-direction: row; align-items: center; }
.pk-dots-label { font-size: 17px; color: rgb(31, 42, 68); margin: 0 6px 0 0; }
.pk-dot { width: 12px; height: 12px; border-radius: 6px; margin: 0 2px; background-color: rgb(214, 96, 40); border-width: 2px; border-color: rgb(150, 56, 20); }
.pk-dot-relief { background-color: rgba(0, 0, 0, 0); border-color: rgb(36, 120, 74); }
